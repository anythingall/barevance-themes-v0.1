{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when settings.store_type is not in this section's type_visibility. Falls back to showing everything if store_type is blank. {%- endcomment -%}
{%- liquid
  assign hl_hide = false
  assign hl_vis = section.settings.type_visibility | default: 'all'
  assign hl_st = settings.store_type | default: 'v1'
  assign hl_on = false
  if template.name == 'index'
    assign hl_on = true
  endif
  if template.name == 'product'
    assign hl_on = true
  endif
  if hl_on and hl_vis != 'all'
    unless hl_vis contains hl_st
      assign hl_hide = true
    endunless
  endif
-%}
{%- unless hl_hide -%}
{%- comment -%}
  vy-faq — Accordion FAQ using native <details>/<summary> (mobile-first, accessible).
  Mobile: single column. Desktop: optional two columns.
{%- endcomment -%}

<div class="vy-faq color-{{ section.settings.color_scheme }} gradient vy-section">
  <div class="vy-container {% if section.settings.narrow and section.settings.show_guarantee == false %}vy-container--narrow{% endif %}">
    <div class="vy-faq__wrap {% if section.settings.show_guarantee %}has-guarantee{% endif %}">
    <div class="vy-faq__main">
    {%- if section.settings.heading != blank -%}
      <h2 class="vy-h2 vy-faq__heading" style="text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- liquid
      assign mf_faq = product.metafields.custom.faq.value
      assign use_mf = false
      if section.settings.source == 'product_metafield' and mf_faq != blank
        assign use_mf = true
      endif
    -%}
    <div class="vy-faq__list" style="--faq-cols: {{ section.settings.columns }};">
      {%- if use_mf -%}
        {%- for item in mf_faq -%}
          <details class="vy-faq__item">
            <summary class="vy-faq__q vy-tap">
              <span>{{ item.question }}</span>
              <span class="vy-faq__icon">{%- render 'custom-icon', icon: 'plus' -%}</span>
            </summary>
            <div class="vy-faq__a rte">{{ item.answer }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <details class="vy-faq__item" {{ block.shopify_attributes }}>
            <summary class="vy-faq__q vy-tap">
              <span>{{ block.settings.question }}</span>
              <span class="vy-faq__icon">{%- render 'custom-icon', icon: 'plus' -%}</span>
            </summary>
            <div class="vy-faq__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} SEO: FAQPage structured data, built from the same Q&A source. {%- endcomment -%}
    {%- assign faq_entries = '' -%}
    {%- if use_mf -%}
      {%- for item in mf_faq -%}
        {%- unless item.question == blank -%}
          {%- capture faq_one -%}{"@type":"Question","name":{{ item.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ item.answer | strip_html | strip_newlines | json }}}}{%- endcapture -%}
          {%- assign faq_entries = faq_entries | append: ',' | append: faq_one -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- unless block.settings.question == blank -%}
          {%- capture faq_one -%}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip_newlines | json }}}}{%- endcapture -%}
          {%- assign faq_entries = faq_entries | append: ',' | append: faq_one -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
    {%- assign faq_entries = faq_entries | remove_first: ',' -%}
    {%- if faq_entries != blank -%}
      <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_entries }}]}</script>
    {%- endif -%}
    </div>

    {%- if section.settings.show_guarantee -%}
      <aside class="vy-faq__guarantee vy-card color-{{ section.settings.guarantee_scheme }} gradient">
        <div class="vy-faq__guarantee-body">
          {%- if section.settings.guarantee_badge != blank -%}
            <span class="vy-faq__seal">{{ section.settings.guarantee_badge }}</span>
          {%- endif -%}
          {%- if section.settings.guarantee_heading != blank -%}
            <h3 class="vy-faq__guarantee-heading">{{ section.settings.guarantee_heading }}</h3>
          {%- endif -%}
          {%- if section.settings.guarantee_text != blank -%}
            <p class="vy-faq__guarantee-text">{{ section.settings.guarantee_text }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.guarantee_image != blank -%}
          {{ section.settings.guarantee_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'vy-faq__guarantee-img', alt: '' }}
        {%- endif -%}
      </aside>
    {%- endif -%}
    </div>
  </div>
</div>

{%- else -%}{%- if request.design_mode -%}<div class="vy-hidden-note" style="padding:1.2rem 1.6rem;margin:0.4rem auto;max-width:60rem;border:0.1rem dashed rgba(128,128,128,0.55);border-radius:0.6rem;font-size:1.3rem;text-align:center;opacity:0.85;">Hidden on the current Store type (<b>{{ settings.store_type | default: 'v1' | upcase }}</b>). Shows on: <b>{{ section.settings.type_visibility | default: 'all' | upcase }}</b>. Change “Store type” in Theme settings, or this section’s “Show on store type”.</div>{%- endif -%}{%- endunless -%}

{% stylesheet %}
  .vy-faq__heading {
    margin: 0 0 2.4rem;
  }

  .vy-faq__wrap {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  .vy-faq__main {
    flex: 1;
    min-width: 0;
  }

  .vy-faq__guarantee {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding: 2.4rem;
    background: rgba(var(--color-foreground), 0.04);
  }

  .vy-faq__seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.2rem;
    height: 5.2rem;
    border-radius: 999px;
    border: 0.2rem solid rgb(var(--color-button));
    color: rgb(var(--color-accent-strong, var(--color-button)));
    font-weight: 700;
    font-size: 1.2rem;
    text-align: center;
    line-height: 1.1;
    flex: 0 0 auto;
    margin-bottom: 1.2rem;
  }

  .vy-faq__guarantee-heading {
    margin: 0 0 0.8rem;
    font-size: 2rem;
  }

  .vy-faq__guarantee-text {
    margin: 0;
    font-size: 1.4rem;
    opacity: 0.85;
    line-height: 1.5;
  }

  .vy-faq__guarantee-img {
    width: 10rem;
    height: auto;
    flex: 0 0 auto;
  }

  @media screen and (min-width: 990px) {
    .vy-faq__wrap.has-guarantee {
      flex-direction: row;
      align-items: flex-start;
      gap: 4rem;
    }

    .vy-faq__wrap.has-guarantee .vy-faq__main {
      flex: 1 1 60%;
    }

    .vy-faq__wrap.has-guarantee .vy-faq__guarantee {
      flex: 0 0 34%;
    }
  }

  .vy-faq__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-content: start;
  }

  .vy-faq__item {
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }

  .vy-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    padding: 1.4rem 0;
    font-weight: 600;
    font-size: 1.6rem;
    list-style: none;
  }

  .vy-faq__q::-webkit-details-marker {
    display: none;
  }

  .vy-faq__icon .svg-wrapper {
    width: 1.6rem;
    height: 1.6rem;
    transition: transform 0.2s ease;
  }

  .vy-faq__item[open] .vy-faq__icon .svg-wrapper {
    transform: rotate(45deg);
  }

  .vy-faq__a {
    padding: 0 0 1.6rem;
    opacity: 0.85;
  }

  @media screen and (min-width: 990px) {
    .vy-faq__list {
      grid-template-columns: repeat(var(--faq-cols, 1), 1fr);
      column-gap: 4rem;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "vy-faq-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All layouts" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "source",
      "label": "Nguồn dữ liệu",
      "info": "Product metafield: đọc product.custom.faq (metaobject) khi ở trang sản phẩm. Fallback về blocks.",
      "options": [
        { "value": "blocks", "label": "Blocks (nhập tay)" },
        { "value": "product_metafield", "label": "Product metafield (faq)" }
      ],
      "default": "blocks"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "header", "content": "Money-back guarantee (bên phải)" },
    { "type": "checkbox", "id": "show_guarantee", "label": "Hiện box bảo đảm hoàn tiền", "default": false },
    { "type": "color_scheme", "id": "guarantee_scheme", "label": "Color scheme của box", "default": "scheme-2" },
    { "type": "text", "id": "guarantee_badge", "label": "Badge (vd 30 DAYS)", "default": "30 DAYS" },
    { "type": "text", "id": "guarantee_heading", "label": "Tiêu đề", "default": "Love It or Get Your Money Back" },
    { "type": "textarea", "id": "guarantee_text", "label": "Mô tả", "default": "We're confident you'll love it. If not, return it within 30 days for a full refund." },
    { "type": "image_picker", "id": "guarantee_image", "label": "Ảnh (tuỳ chọn)" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Số cột (desktop)",
      "options": [
        { "value": "1", "label": "1 cột" },
        { "value": "2", "label": "2 cột" }
      ],
      "default": "1"
    },
    { "type": "checkbox", "id": "narrow", "label": "Giới hạn bề rộng nội dung", "default": true }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
