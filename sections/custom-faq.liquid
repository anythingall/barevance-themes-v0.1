{%- comment -%}
  custom-faq — Accordion FAQ using native <details>/<summary> (mobile-first, accessible).
  Mobile: single column. Desktop: optional two columns.
{%- endcomment -%}

<div class="custom-faq color-{{ section.settings.color_scheme }} gradient custom-section">
  <div class="custom-container {% if section.settings.narrow %}custom-container--narrow{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-h2 custom-faq__heading" style="text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- liquid
      assign mf_faq = product.metafields.custom.faq.value
      assign use_mf = false
      if section.settings.source == 'product_metafield' and mf_faq != blank
        assign use_mf = true
      endif
    -%}
    <div class="custom-faq__list" style="--faq-cols: {{ section.settings.columns }};">
      {%- if use_mf -%}
        {%- for item in mf_faq -%}
          <details class="custom-faq__item">
            <summary class="custom-faq__q custom-tap">
              <span>{{ item.question }}</span>
              <span class="custom-faq__icon">{%- render 'custom-icon', icon: 'plus' -%}</span>
            </summary>
            <div class="custom-faq__a rte">{{ item.answer }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <details class="custom-faq__item" {{ block.shopify_attributes }}>
            <summary class="custom-faq__q custom-tap">
              <span>{{ block.settings.question }}</span>
              <span class="custom-faq__icon">{%- render 'custom-icon', icon: 'plus' -%}</span>
            </summary>
            <div class="custom-faq__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-faq__heading {
    margin: 0 0 2.4rem;
  }

  .custom-faq__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-content: start;
  }

  .custom-faq__item {
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }

  .custom-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    padding: 1.4rem 0;
    font-weight: 600;
    font-size: 1.6rem;
    list-style: none;
  }

  .custom-faq__q::-webkit-details-marker {
    display: none;
  }

  .custom-faq__icon .svg-wrapper {
    width: 1.6rem;
    height: 1.6rem;
    transition: transform 0.2s ease;
  }

  .custom-faq__item[open] .custom-faq__icon .svg-wrapper {
    transform: rotate(45deg);
  }

  .custom-faq__a {
    padding: 0 0 1.6rem;
    opacity: 0.85;
  }

  @media screen and (min-width: 990px) {
    .custom-faq__list {
      grid-template-columns: repeat(var(--faq-cols, 1), 1fr);
      column-gap: 4rem;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "custom-faq-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "source",
      "label": "Nguồn dữ liệu",
      "info": "Product metafield: đọc product.custom.faq (metaobject) khi ở trang sản phẩm. Fallback về blocks.",
      "options": [
        { "value": "blocks", "label": "Blocks (nhập tay)" },
        { "value": "product_metafield", "label": "Product metafield (faq)" }
      ],
      "default": "blocks"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Số cột (desktop)",
      "options": [
        { "value": "1", "label": "1 cột" },
        { "value": "2", "label": "2 cột" }
      ],
      "default": "1"
    },
    { "type": "checkbox", "id": "narrow", "label": "Giới hạn bề rộng nội dung", "default": true }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
