{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when settings.store_type is not in this section's type_visibility. Falls back to showing everything if store_type is blank. {%- endcomment -%}
{%- liquid
  assign hl_hide = false
  assign hl_vis = section.settings.type_visibility | default: 'all'
  assign hl_st = settings.store_type | default: 'v1'
  assign hl_on = false
  if template.name == 'index'
    assign hl_on = true
  endif
  if template.name == 'product'
    assign hl_on = true
  endif
  if hl_on and hl_vis != 'all'
    unless hl_vis contains hl_st
      assign hl_hide = true
    endunless
  endif
-%}
{%- unless hl_hide -%}
{%- comment -%}
  vy-reviews — Testimonial / review cards (mobile-first).
  Mobile: horizontal scroll-snap carousel. Desktop: grid of N columns.
  Manual blocks now; a metafield/app source can be added later without markup changes.
{%- endcomment -%}

{%- if section.settings.layout == 'split' -%}
  <div class="vy-reviews vy-reviews--split color-{{ section.settings.color_scheme }} gradient vy-section">
    <div class="vy-reviews__split">
      <div class="vy-reviews__media">
        {%- if section.settings.image_url != blank -%}
          <img
            class="vy-reviews__media-img"
            src="{{ section.settings.image_url }}"
            width="1200"
            height="900"
            alt="{{ section.settings.left_heading | escape }}"
            loading="lazy"
          >
        {%- endif -%}
        <span class="vy-reviews__media-scrim" aria-hidden="true"></span>
        <div class="vy-reviews__media-inner">
          {%- if section.settings.left_heading != blank -%}
            <h2 class="vy-reviews__media-title">{{ section.settings.left_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.left_subheading != blank -%}
            <p class="vy-reviews__media-sub">{{ section.settings.left_subheading }}</p>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <div class="vy-reviews__cta-row">
              <a class="vy-reviews__cta" href="{{ section.settings.button_link | default: '#' }}">
                {{ section.settings.button_label }}
              </a>
              {%- if section.settings.show_play -%}
                <a
                  class="vy-reviews__play"
                  href="{{ section.settings.button_link | default: '#' }}"
                  aria-label="{{ section.settings.button_label | escape }}"
                >
                  {%- render 'custom-icon', icon: 'play' -%}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
      <div class="vy-reviews__panel" data-reviews-slider>
        {%- if section.settings.heading != blank or section.blocks.size > 1 -%}
          <div class="vy-reviews__panel-head">
            {%- if section.settings.heading != blank -%}
              <h2 class="vy-reviews__panel-title">{{ section.settings.heading }}</h2>
            {%- endif -%}
            <div class="vy-reviews__nav">
              <button
                type="button"
                class="vy-reviews__nav-btn vy-reviews__nav-btn--prev"
                data-reviews-prev
                aria-label="{{ 'general.slider.previous_slide' | t | default: 'Previous' }}"
              >
                {%- render 'custom-icon', icon: 'arrow' -%}
              </button>
              <button
                type="button"
                class="vy-reviews__nav-btn vy-reviews__nav-btn--next"
                data-reviews-next
                aria-label="{{ 'general.slider.next_slide' | t | default: 'Next' }}"
              >
                {%- render 'custom-icon', icon: 'arrow' -%}
              </button>
            </div>
          </div>
        {%- endif -%}
        <div class="vy-reviews__track" data-reviews-track>
          {%- for block in section.blocks -%}
            <div class="vy-reviews__card vy-card" {{ block.shopify_attributes }}>
              {%- if block.settings.text != blank -%}
                <p class="vy-reviews__quote">{{ block.settings.text }}</p>
              {%- endif -%}
              <div class="vy-reviews__stars">{%- render 'custom-stars', rating: block.settings.stars -%}</div>
              <div class="vy-reviews__author">
                {%- if block.settings.avatar_url != blank -%}
                  <img
                    class="vy-reviews__avatar"
                    src="{{ block.settings.avatar_url }}"
                    width="88"
                    height="88"
                    alt="{{ block.settings.name | escape }}"
                    loading="lazy"
                  >
                {%- elsif block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 120
                    | image_tag: loading: 'lazy', class: 'vy-reviews__avatar', alt: block.settings.name
                  }}
                {%- endif -%}
                <span class="vy-reviews__author-body">
                  {%- if block.settings.name != blank -%}
                    <span class="vy-reviews__name">{{ block.settings.name }}</span>
                  {%- endif -%}
                  {%- if block.settings.badge != blank -%}
                    <span class="vy-reviews__verified">{{ block.settings.badge }}</span>
                  {%- endif -%}
                </span>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
  <script>
    (function () {
      document.querySelectorAll('[data-reviews-slider]').forEach(function (root) {
        var track = root.querySelector('[data-reviews-track]');
        if (!track) return;
        var prev = root.querySelector('[data-reviews-prev]');
        var next = root.querySelector('[data-reviews-next]');
        function step() {
          var card = track.firstElementChild;
          if (!card) return track.clientWidth;
          var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 16;
          return card.getBoundingClientRect().width + gap;
        }
        function update() {
          if (!prev || !next) return;
          var max = track.scrollWidth - track.clientWidth - 1;
          prev.disabled = track.scrollLeft <= 0;
          next.disabled = track.scrollLeft >= max;
        }
        prev && prev.addEventListener('click', function () {
          track.scrollBy({ left: -step(), behavior: 'smooth' });
        });
        next && next.addEventListener('click', function () {
          track.scrollBy({ left: step(), behavior: 'smooth' });
        });
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      });
    })();
  </script>
{%- else -%}
<div class="vy-reviews color-{{ section.settings.color_scheme }} gradient vy-section">
  <div class="vy-container">
    {%- liquid
      assign mf_reviews = product.metafields.custom.reviews.value
      assign use_mf = false
      if section.settings.source == 'product_metafield' and mf_reviews != blank
        assign use_mf = true
      endif
      assign review_count = section.blocks.size
      if use_mf
        assign review_count = mf_reviews | size
      endif
      assign review_cols = section.settings.columns | at_most: review_count | at_least: 1
    -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="vy-reviews__head" style="text-align: {{ section.settings.heading_alignment }};">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vy-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vy-h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="vy-reviews__grid vy-scroller vy-scroller--grid-on-desktop list-unstyled"
      style="--vy-scroller-cols-desktop: {{ review_cols }}; --vy-scroller-item: 82%;"
      tabindex="0"
      role="group"
      aria-label="Customer reviews (scroll to see more)"
    >
      {%- if use_mf -%}
        {%- for review in mf_reviews -%}
          <div class="vy-reviews__card vy-card">
            <div class="vy-reviews__stars">{%- render 'custom-stars', rating: review.rating -%}</div>
            {%- if review.text != blank -%}
              <p class="vy-reviews__text">{{ review.text }}</p>
            {%- endif -%}
            <div class="vy-reviews__author">
              {%- if review.avatar != blank -%}
                {{ review.avatar | image_url: width: 120 | image_tag: loading: 'lazy', class: 'vy-reviews__avatar', alt: review.author }}
              {%- endif -%}
              <span class="vy-reviews__author-body">
                {%- if review.author != blank -%}
                  <span class="vy-reviews__name">{{ review.author }}</span>
                {%- endif -%}
                {%- if review.badge != blank -%}
                  <span class="vy-reviews__verified">{{ review.badge }}</span>
                {%- endif -%}
              </span>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="vy-reviews__card vy-card" {{ block.shopify_attributes }}>
            <div class="vy-reviews__stars">{%- render 'custom-stars', rating: block.settings.stars -%}</div>
            {%- if block.settings.text != blank -%}
              <p class="vy-reviews__text">{{ block.settings.text }}</p>
            {%- endif -%}
            <div class="vy-reviews__author">
              {%- if block.settings.avatar_url != blank -%}
                <img class="vy-reviews__avatar" src="{{ block.settings.avatar_url }}" width="120" height="120" loading="lazy" alt="{{ block.settings.name | escape }}">
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 120
                  | image_tag: loading: 'lazy', class: 'vy-reviews__avatar', alt: block.settings.name
                }}
              {%- endif -%}
              <span class="vy-reviews__author-body">
                {%- if block.settings.name != blank -%}
                  <span class="vy-reviews__name">{{ block.settings.name }}</span>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}
                  <span class="vy-reviews__verified">{{ block.settings.badge }}</span>
                {%- endif -%}
              </span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} SEO: on a product page, expose product reviews as AggregateRating + Review on
      a Product node keyed to this product's URL (merges with main-product's Product JSON-LD).
      Only from product-metafield reviews (block reviews are generic testimonials). {%- endcomment -%}
    {%- if template.name == 'product' and product != blank and use_mf -%}
      {%- assign r_count = 0 -%}
      {%- assign r_sum = 0 -%}
      {%- assign r_items = '' -%}
      {%- for review in mf_reviews -%}
        {%- assign rr = review.rating | plus: 0 -%}
        {%- if rr <= 0 -%}{%- assign rr = 5 -%}{%- endif -%}
        {%- assign r_count = r_count | plus: 1 -%}
        {%- assign r_sum = r_sum | plus: rr -%}
        {%- capture r_one -%}{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":{{ rr }},"bestRating":5},"author":{"@type":"Person","name":{{ review.author | default: 'Verified Buyer' | json }}}{%- if review.text != blank -%},"reviewBody":{{ review.text | strip_html | strip_newlines | json }}{%- endif -%}}{%- endcapture -%}
        {%- assign r_items = r_items | append: ',' | append: r_one -%}
      {%- endfor -%}
      {%- assign r_items = r_items | remove_first: ',' -%}
      {%- if r_count > 0 -%}
        {%- assign r_avg = r_sum | times: 1.0 | divided_by: r_count -%}
        {%- capture r_url -%}{{ product.url | prepend: request.origin }}{%- endcapture -%}
        <script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","@id":{{ r_url | json }},"url":{{ r_url | json }},"name":{{ product.title | json }},"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ r_avg | round: 1 }},"reviewCount":{{ r_count }},"bestRating":5},"review":[{{ r_items }}]}</script>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{%- else -%}{%- if request.design_mode -%}<div class="vy-hidden-note" style="padding:1.2rem 1.6rem;margin:0.4rem auto;max-width:60rem;border:0.1rem dashed rgba(128,128,128,0.55);border-radius:0.6rem;font-size:1.3rem;text-align:center;opacity:0.85;">Hidden on the current Store type (<b>{{ settings.store_type | default: 'v1' | upcase }}</b>). Shows on: <b>{{ section.settings.type_visibility | default: 'all' | upcase }}</b>. Change “Store type” in Theme settings, or this section’s “Show on store type”.</div>{%- endif -%}{%- endunless -%}

{% stylesheet %}
  .vy-reviews__head {
    margin-bottom: 2.8rem;
  }

  .vy-reviews__head .vy-eyebrow {
    margin: 0 0 0.6rem;
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  .vy-reviews__head .vy-h2 {
    margin: 0;
  }

  .vy-reviews__card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2rem;
    background: rgba(var(--color-foreground), 0.04);
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    height: 100%;
  }

  .vy-reviews__text {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.55;
  }

  .vy-reviews__author {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .vy-reviews__avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .vy-reviews__author-body {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .vy-reviews__name {
    font-weight: 600;
    font-size: 1.4rem;
  }

  .vy-reviews__verified {
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.68);
  }

  /* ---------- Split layout (photo CTA + review cards) ---------- */
  .vy-reviews--split.vy-section {
    padding: 0;
  }

  .vy-reviews__split {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 990px) {
    .vy-reviews__split {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Left: full-bleed photo with overlaid content */
  .vy-reviews__media {
    position: relative;
    min-height: 34rem;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  @media screen and (min-width: 990px) {
    .vy-reviews__media {
      min-height: 46rem;
    }
  }

  .vy-reviews__media-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vy-reviews__media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.35) 45%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  .vy-reviews__media-inner {
    position: relative;
    z-index: 1;
    color: #fff;
    padding: 3.2rem 2.4rem;
    max-width: 46rem;
  }

  @media screen and (min-width: 990px) {
    .vy-reviews__media-inner {
      padding: 4rem 4.5rem;
    }
  }

  .vy-reviews__media-title {
    margin: 0 0 1rem;
    color: #fff;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    line-height: 1.1;
    font-size: calc(3.2rem * var(--font-heading-scale, 1));
    text-wrap: balance;
  }

  @media screen and (min-width: 990px) {
    .vy-reviews__media-title {
      font-size: calc(3.8rem * var(--font-heading-scale, 1));
    }
  }

  .vy-reviews__media-sub {
    margin: 0 0 2rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.6rem;
    line-height: 1.5;
  }

  .vy-reviews__cta-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .vy-reviews__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: #171b18;
    font-weight: 600;
    font-size: 1.5rem;
    text-decoration: none;
    padding: 1.4rem 2.6rem;
    border-radius: 999px;
    min-height: 4.8rem;
  }

  .vy-reviews__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 999px;
    background: #fff;
    color: #171b18;
    flex: 0 0 auto;
  }

  .vy-reviews__play .svg-wrapper,
  .vy-reviews__play svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  /* Right: light panel with review-card slider */
  .vy-reviews__panel {
    background: rgba(var(--color-foreground), 0.045);
    padding: 3.2rem 2.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  @media screen and (min-width: 990px) {
    .vy-reviews__panel {
      padding: 4rem;
    }
  }

  .vy-reviews__panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    margin-bottom: 2rem;
  }

  .vy-reviews__panel-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: calc(2.2rem * var(--font-heading-scale, 1));
    line-height: 1.2;
    color: rgb(var(--color-foreground));
  }

  .vy-reviews__nav {
    display: flex;
    gap: 0.8rem;
    flex: 0 0 auto;
  }

  .vy-reviews__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border: 0;
    background: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    border-radius: 999px;
    transition: background 0.15s ease, opacity 0.15s ease;
  }

  .vy-reviews__nav-btn:hover {
    background: rgba(var(--color-foreground), 0.08);
  }

  .vy-reviews__nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
    background: transparent;
  }

  .vy-reviews__nav-btn .svg-wrapper,
  .vy-reviews__nav-btn svg {
    width: 2rem;
    height: 2rem;
  }

  .vy-reviews__nav-btn--prev svg {
    transform: rotate(180deg);
  }

  /* Horizontal slider track (arrows scroll it) */
  .vy-reviews__track {
    display: flex;
    gap: 1.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.4rem;
    min-width: 0;
  }

  .vy-reviews__track::-webkit-scrollbar {
    display: none;
  }

  .vy-reviews__card {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 2rem 1.8rem;
    background: rgb(var(--color-background));
    border: 0;
    border-radius: 1.4rem;
    box-shadow: 0 1rem 2.4rem rgba(0, 0, 0, 0.07);
    flex: 0 0 80%;
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .vy-reviews__card {
      flex-basis: calc((100% - 3.2rem) / 3);
    }
  }

  .vy-reviews__quote {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 1.7rem;
    line-height: 1.35;
    color: rgb(var(--color-foreground));
    quotes: "\201C" "\201D";
  }

  .vy-reviews__quote::before {
    content: open-quote;
  }

  .vy-reviews__quote::after {
    content: close-quote;
  }

  .vy-reviews__card .vy-reviews__author {
    margin-top: auto;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "vy-reviews-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All layouts" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Split = left lifestyle photo + CTA, right review cards (design). Stack = centered heading + card row.",
      "options": [
        { "value": "stack", "label": "Stacked (centered heading + cards)" },
        { "value": "split", "label": "Split (photo CTA + cards)" }
      ],
      "default": "stack"
    },
    { "type": "header", "content": "Split layout — left photo panel" },
    { "type": "text", "id": "image_url", "label": "Ảnh (URL CDN)" },
    { "type": "text", "id": "left_heading", "label": "Tiêu đề (trên ảnh)", "default": "Real People. Real Comfort." },
    { "type": "text", "id": "left_subheading", "label": "Mô tả (trên ảnh)", "default": "See how Voya fits into everyday life." },
    { "type": "text", "id": "button_label", "label": "Nút — nhãn", "default": "Watch Customer Stories" },
    { "type": "url", "id": "button_link", "label": "Nút — liên kết" },
    { "type": "checkbox", "id": "show_play", "label": "Hiện icon play cạnh nút", "default": true },
    {
      "type": "select",
      "id": "source",
      "label": "Nguồn dữ liệu",
      "info": "Product metafield: đọc product.custom.reviews (metaobject) khi ở trang sản phẩm. Fallback về blocks.",
      "options": [
        { "value": "blocks", "label": "Blocks (nhập tay)" },
        { "value": "product_metafield", "label": "Product metafield (reviews)" }
      ],
      "default": "blocks"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by Thousands of Customers" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Số cột (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
