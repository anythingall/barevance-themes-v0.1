{%- comment -%}
  custom-icon-benefits — "Why customers love it" icon grid (mobile-first).
  Grid of icon + title + text blocks. Mobile: 1–2 cols or horizontal scroller.
{%- endcomment -%}

<div class="custom-benefits color-{{ section.settings.color_scheme }} gradient custom-section">
  <div class="custom-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="custom-benefits__head" style="text-align: {{ section.settings.heading_alignment }};">
        {%- if section.settings.eyebrow != blank -%}
          <p class="custom-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="custom-h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="custom-benefits__grid {% if section.settings.mobile_layout == 'carousel' %}custom-scroller custom-scroller--grid-on-desktop{% else %}custom-grid{% endif %} list-unstyled"
      role="list"
      style="--custom-grid-cols-desktop: {{ section.settings.columns }}; --custom-grid-cols-tablet: {{ section.settings.columns | at_most: 3 }}; --custom-scroller-cols-desktop: {{ section.settings.columns }}; --custom-scroller-item: 60%;"
    >
      {%- liquid
        assign mf_benefits = product.metafields.custom.benefits.value
        assign use_mf = false
        if section.settings.source == 'product_metafield' and mf_benefits != blank
          assign use_mf = true
        endif
      -%}
      {%- if use_mf -%}
        {%- for feature in mf_benefits -%}
          <li class="custom-benefits__item" style="text-align: {{ section.settings.item_alignment }};">
            {%- if feature.icon != blank -%}
              <span class="custom-benefits__icon">{%- render 'custom-icon', icon: feature.icon -%}</span>
            {%- endif -%}
            {%- if feature.title != blank -%}
              <h3 class="custom-benefits__title">{{ feature.title }}</h3>
            {%- endif -%}
            {%- if feature.text != blank -%}
              <p class="custom-benefits__text">{{ feature.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <li class="custom-benefits__item" style="text-align: {{ section.settings.item_alignment }};" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="custom-benefits__icon">{%- render 'custom-icon', icon: block.settings.icon -%}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="custom-benefits__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="custom-benefits__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .custom-benefits__head {
    margin-bottom: 3rem;
  }

  .custom-benefits__head .custom-eyebrow {
    margin: 0 0 0.6rem;
    color: rgb(var(--color-button));
  }

  .custom-benefits__head .custom-h2 {
    margin: 0;
  }

  .custom-benefits__grid {
    margin: 0;
    padding: 0;
  }

  .custom-benefits__item {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: center;
  }

  .custom-benefits__item[style*='left'] {
    align-items: flex-start;
  }

  .custom-benefits__icon .svg-wrapper {
    width: 3.4rem;
    height: 3.4rem;
    color: rgb(var(--color-button));
  }

  .custom-benefits__title {
    margin: 0;
    font-size: 1.7rem;
  }

  .custom-benefits__text {
    margin: 0;
    font-size: 1.4rem;
    opacity: 0.82;
    line-height: 1.5;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Icon benefits",
  "tag": "section",
  "class": "custom-benefits-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "source",
      "label": "Nguồn dữ liệu",
      "info": "Product metafield: đọc từ product.custom.benefits (metaobject) khi ở trang sản phẩm. Fallback về blocks nếu trống.",
      "options": [
        { "value": "blocks", "label": "Blocks (nhập tay)" },
        { "value": "product_metafield", "label": "Product metafield (benefits)" }
      ],
      "default": "blocks"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why customers love it" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "item_alignment",
      "label": "Căn nội dung item",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Số cột (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Layout mobile",
      "options": [
        { "value": "stack", "label": "Xếp dọc (1 cột)" },
        { "value": "carousel", "label": "Cuộn ngang" }
      ],
      "default": "carousel"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "heart",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "lock", "label": "Lock" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "check_mark", "label": "Check" },
            { "value": "eye", "label": "Eye" },
            { "value": "paw_print", "label": "Paw" },
            { "value": "plane", "label": "Plane" },
            { "value": "star", "label": "Star" },
            { "value": "fire", "label": "Fire" },
            { "value": "truck", "label": "Truck" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "return", "label": "Return" },
            { "value": "chat_bubble", "label": "Chat" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Cozy & Comfy" },
        { "type": "text", "id": "text", "label": "Text", "default": "Soft interior keeps them calm and relaxed." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "heart", "title": "Cozy & Comfy" } },
        { "type": "benefit", "settings": { "icon": "eye", "title": "Breathe Easy" } },
        { "type": "benefit", "settings": { "icon": "padlock", "title": "Built for Safety" } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Lightweight" } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Super Adorable" } }
      ]
    }
  ]
}
{% endschema %}
