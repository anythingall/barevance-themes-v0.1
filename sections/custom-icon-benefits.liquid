{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when settings.store_type is not in this section's type_visibility. Falls back to showing everything if store_type is blank. {%- endcomment -%}
{%- liquid
  assign hl_hide = false
  assign hl_vis = section.settings.type_visibility | default: 'all'
  assign hl_st = settings.store_type | default: 'v1'
  assign hl_on = false
  if template.name == 'index'
    assign hl_on = true
  endif
  if template.name == 'product'
    assign hl_on = true
  endif
  if hl_on and hl_vis != 'all'
    unless hl_vis contains hl_st
      assign hl_hide = true
    endunless
  endif
-%}
{%- unless hl_hide -%}
{%- comment -%}
  vy-icon-benefits — "Why customers love it" icon grid (mobile-first).
  Grid of icon + title + text blocks. Mobile: 1–2 cols or horizontal scroller.
{%- endcomment -%}

<div class="vy-benefits color-{{ section.settings.color_scheme }} gradient vy-section">
  <div class="vy-container">
    {%- liquid
      assign mf_benefits = product.metafields.custom.benefits.value
      assign use_mf = false
      if section.settings.source == 'product_metafield' and mf_benefits != blank
        assign use_mf = true
      endif
      assign benefit_count = section.blocks.size
      if use_mf
        assign benefit_count = mf_benefits | size
      endif
      assign benefit_cols = section.settings.columns | at_most: benefit_count | at_least: 1
    -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="vy-benefits__head" style="text-align: {{ section.settings.heading_alignment }};">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vy-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vy-h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="vy-benefits__grid {% if section.settings.card_container %}is-carded{% endif %} {% if section.settings.mobile_layout == 'carousel' %}vy-scroller vy-scroller--grid-on-desktop{% else %}vy-grid{% endif %} list-unstyled"
      role="list"
      {%- if section.settings.mobile_layout == 'carousel' %} tabindex="0" aria-label="Benefits (scroll to see more)"{% endif %}
      style="--vy-grid-cols-desktop: {{ benefit_cols }}; --vy-grid-cols-tablet: {{ benefit_cols | at_most: 3 }}; --vy-scroller-cols-desktop: {{ benefit_cols }}; --vy-scroller-item: 60%;"
    >
      {%- if use_mf -%}
        {%- for feature in mf_benefits -%}
          <li class="vy-benefits__item" style="text-align: {{ section.settings.item_alignment }};">
            {%- if feature.icon != blank -%}
              <span class="vy-benefits__icon">{%- render 'custom-icon', icon: feature.icon -%}</span>
            {%- endif -%}
            {%- if feature.title != blank -%}
              <h3 class="vy-benefits__title">{{ feature.title }}</h3>
            {%- endif -%}
            {%- if feature.text != blank -%}
              <p class="vy-benefits__text">{{ feature.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <li class="vy-benefits__item" style="text-align: {{ section.settings.item_alignment }};" {{ block.shopify_attributes }}>
            {%- if block.settings.image_url != blank -%}
              <span class="vy-benefits__photo"><img src="{{ block.settings.image_url }}" width="360" height="360" loading="lazy" alt="{{ block.settings.title | escape }}"></span>
            {%- elsif block.settings.icon != 'none' -%}
              <span class="vy-benefits__icon">{%- render 'custom-icon', icon: block.settings.icon -%}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="vy-benefits__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="vy-benefits__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{%- else -%}{%- if request.design_mode -%}<div class="vy-hidden-note" style="padding:1.2rem 1.6rem;margin:0.4rem auto;max-width:60rem;border:0.1rem dashed rgba(128,128,128,0.55);border-radius:0.6rem;font-size:1.3rem;text-align:center;opacity:0.85;">Hidden on the current Store type (<b>{{ settings.store_type | default: 'v1' | upcase }}</b>). Shows on: <b>{{ section.settings.type_visibility | default: 'all' | upcase }}</b>. Change “Store type” in Theme settings, or this section’s “Show on store type”.</div>{%- endif -%}{%- endunless -%}

{% stylesheet %}
  .vy-benefits__head {
    margin-bottom: 3rem;
  }

  .vy-benefits__head .vy-eyebrow {
    margin: 0 0 0.6rem;
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  .vy-benefits__head .vy-h2 {
    margin: 0;
  }

  .vy-benefits__grid {
    margin: 0;
    padding: 0;
  }

  /* Optional card container wrapping the whole grid (matches reference) */
  .vy-benefits__grid.is-carded {
    background: rgba(var(--color-foreground), 0.04);
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    border-radius: var(--vy-card-radius, 1.6rem);
    padding: 2.8rem 2rem;
  }

  .vy-benefits__item {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: center;
  }

  .vy-benefits__item[style*='left'] {
    align-items: flex-start;
  }

  /* Icon in a soft circle (matches reference) */
  .vy-benefits__icon {
    width: auto;
    height: auto;
    border-radius: 0;
    background: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
  }

  .vy-benefits__icon .svg-wrapper {
    width: 5.2rem;
    height: 5.2rem;
    color: rgb(var(--color-foreground));
  }

  .vy-benefits__title {
    margin: 0;
    font-size: 1.7rem;
  }

  .vy-benefits__text {
    margin: 0;
    font-size: 1.4rem;
    opacity: 0.82;
    line-height: 1.5;
  }

  /* Photo variant (rounded square image instead of icon circle) */
  .vy-benefits__photo {
    display: block;
    width: 100%;
    max-width: 15rem;
    aspect-ratio: 1 / 1;
    border-radius: 1.4rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.05);
    margin-bottom: 0.4rem;
  }

  .vy-benefits__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Icon benefits",
  "tag": "section",
  "class": "vy-benefits-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All layouts" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "source",
      "label": "Nguồn dữ liệu",
      "info": "Product metafield: đọc từ product.custom.benefits (metaobject) khi ở trang sản phẩm. Fallback về blocks nếu trống.",
      "options": [
        { "value": "blocks", "label": "Blocks (nhập tay)" },
        { "value": "product_metafield", "label": "Product metafield (benefits)" }
      ],
      "default": "blocks"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why customers love it" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "item_alignment",
      "label": "Căn nội dung item",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Số cột (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "card_container",
      "label": "Bọc trong card (nền + viền)",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Layout mobile",
      "options": [
        { "value": "stack", "label": "Xếp dọc (1 cột)" },
        { "value": "carousel", "label": "Cuộn ngang" }
      ],
      "default": "carousel"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "heart",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "lock", "label": "Lock" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "check_mark", "label": "Check" },
            { "value": "eye", "label": "Eye" },
            { "value": "paw_print", "label": "Paw" },
            { "value": "plane", "label": "Plane" },
            { "value": "star", "label": "Star" },
            { "value": "fire", "label": "Fire" },
            { "value": "truck", "label": "Truck" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "return", "label": "Return" },
            { "value": "chat_bubble", "label": "Chat" }
          ]
        },
        { "type": "text", "id": "image_url", "label": "Ảnh (URL CDN) — thay icon nếu có" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cozy & Comfy" },
        { "type": "text", "id": "text", "label": "Text", "default": "Soft interior keeps them calm and relaxed." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "heart", "title": "Cozy & Comfy" } },
        { "type": "benefit", "settings": { "icon": "eye", "title": "Breathe Easy" } },
        { "type": "benefit", "settings": { "icon": "padlock", "title": "Built for Safety" } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Lightweight" } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Super Adorable" } }
      ]
    }
  ]
}
{% endschema %}
