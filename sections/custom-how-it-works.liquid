{%- comment -%}
  vy-how-it-works — Numbered steps (auto-numbered) + optional media (mobile-first).
  Mobile: steps stack vertically. Desktop: steps in a row, optional media beside.
{%- endcomment -%}

<div class="vy-hiw color-{{ section.settings.color_scheme }} gradient vy-section">
  <div class="vy-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="vy-hiw__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vy-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vy-h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vy-hiw__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="vy-hiw__layout {% if section.settings.image != blank %}has-media{% endif %}">
      <ol class="vy-hiw__steps list-unstyled">
        {%- for block in section.blocks -%}
          <li class="vy-hiw__step" {{ block.shopify_attributes }}>
            <span class="vy-hiw__num">{{ forloop.index }}</span>
            <span class="vy-hiw__step-body">
              {%- if block.settings.title != blank -%}
                <span class="vy-hiw__step-title">{{ block.settings.title }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="vy-hiw__step-text">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.image != blank -%}
        <div class="vy-hiw__media vy-card">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 40vw, 100vw',
              widths: '450, 660, 900, 1200',
              class: 'vy-hiw__image',
              alt: section.settings.image.alt
          }}
          {%- if section.settings.video_url != blank -%}
            <a href="{{ section.settings.video_url }}" class="vy-hiw__play" target="_blank" rel="noopener" aria-label="Play video">
              {%- render 'custom-icon', icon: 'play' -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vy-hiw__head {
    margin-bottom: 2.8rem;
    text-align: center;
  }

  .vy-hiw__head .vy-eyebrow {
    margin: 0 0 0.6rem;
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  .vy-hiw__head .vy-h2 {
    margin: 0;
  }

  .vy-hiw__sub {
    margin: 0.8rem 0 0;
    opacity: 0.8;
  }

  .vy-hiw__layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Steps = a vertical timeline (numbers connected by a line). */
  .vy-hiw__steps {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .vy-hiw__step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.4rem;
    padding-bottom: 2.6rem;
  }

  .vy-hiw__step:last-child {
    padding-bottom: 0;
  }

  /* Connector line running from each number down to the next. */
  .vy-hiw__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 3.8rem;
    bottom: 0.2rem;
    left: 1.9rem;
    width: 0.2rem;
    transform: translateX(-50%);
    background: rgba(var(--color-foreground), 0.15);
  }

  .vy-hiw__num {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    width: 3.8rem;
    height: 3.8rem;
    border-radius: 999px;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.5rem;
  }

  .vy-hiw__step-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.5rem;
  }

  .vy-hiw__step-title {
    font-weight: 600;
    font-size: 1.7rem;
  }

  .vy-hiw__step-text {
    font-size: 1.45rem;
    opacity: 0.82;
    line-height: 1.55;
  }

  .vy-hiw__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .vy-hiw__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vy-hiw__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 6rem;
    height: 6rem;
    border-radius: 999px;
    background: rgba(var(--color-background), 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vy-hiw__play .svg-wrapper {
    width: 2.4rem;
    height: 2.4rem;
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  /* No media: show the steps as an evenly-spaced row of cards on larger screens. */
  @media screen and (min-width: 750px) {
    .vy-hiw__layout:not(.has-media) .vy-hiw__steps {
      flex-direction: row;
      gap: 2.4rem;
      max-width: 96rem;
      margin-inline: auto;
    }

    .vy-hiw__layout:not(.has-media) .vy-hiw__step {
      flex: 1;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.2rem;
      padding-bottom: 0;
    }

    .vy-hiw__layout:not(.has-media) .vy-hiw__step::before {
      display: none;
    }

    .vy-hiw__layout:not(.has-media) .vy-hiw__step-body {
      align-items: center;
      padding-top: 0;
    }
  }

  /* With media: two balanced columns (timeline beside the image). */
  @media screen and (min-width: 990px) {
    .vy-hiw__layout.has-media {
      flex-direction: row;
      align-items: center;
      gap: 5rem;
    }

    .vy-hiw__layout.has-media .vy-hiw__steps {
      flex: 1 1 48%;
      min-width: 0;
    }

    .vy-hiw__layout.has-media .vy-hiw__media {
      flex: 1 1 52%;
      align-self: stretch;
      aspect-ratio: auto;
      min-height: 34rem;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "vy-hiw-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Simple steps to get started." },
    { "type": "header", "content": "Media (optional)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "video_url", "label": "Video link (play button)" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text", "default": "Describe this step." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "text": "Place your item inside." } },
        { "type": "step", "settings": { "text": "Secure and adjust." } },
        { "type": "step", "settings": { "text": "Head out and enjoy!" } }
      ]
    }
  ]
}
{% endschema %}
