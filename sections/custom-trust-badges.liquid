{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when the Store type setting (settings.store_type) is not in type_visibility. {%- endcomment -%}
{%- liquid
  assign hl_hide = false
  assign hl_vis = section.settings.type_visibility | default: 'all'
  assign hl_st = settings.store_type | default: 'v1'
  assign hl_on = false
  if template.name == 'index'
    assign hl_on = true
  endif
  if template.name == 'product'
    assign hl_on = true
  endif
  if hl_on and hl_vis != 'all'
    unless hl_vis contains hl_st
      assign hl_hide = true
    endunless
  endif
-%}
{%- unless hl_hide -%}
{%- comment -%}
  custom-trust-badges — Compact row of trust signals (icon + title + subtitle).
  Free shipping / Guarantee / Secure / Support. Mobile: 2 cols; desktop: N cols.
{%- endcomment -%}

<div class="custom-trust color-{{ section.settings.color_scheme }} gradient custom-section custom-trust--pad-{{ section.settings.padding }}">
  <div class="custom-container">
    <ul class="custom-trust__grid list-unstyled" role="list" style="--trust-cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="custom-trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="custom-trust__icon">{%- render 'custom-icon', icon: block.settings.icon -%}</span>
          {%- endif -%}
          <span class="custom-trust__body">
            {%- if block.settings.title != blank -%}
              <span class="custom-trust__title">{{ block.settings.title }}</span>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <span class="custom-trust__subtitle">{{ block.settings.subtitle }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{%- endunless -%}

{% stylesheet %}
  .custom-trust--pad-none {
    padding-block: 1.6rem;
  }

  .custom-trust__grid {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  .custom-trust__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    text-align: left;
  }

  .custom-trust__icon .svg-wrapper {
    width: 2.6rem;
    height: 2.6rem;
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  .custom-trust__body {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .custom-trust__title {
    font-weight: 600;
    font-size: 1.4rem;
  }

  .custom-trust__subtitle {
    font-size: 1.2rem;
    opacity: 0.75;
  }

  @media screen and (min-width: 750px) {
    .custom-trust__grid {
      grid-template-columns: repeat(var(--trust-cols, 4), 1fr);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "custom-trust-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All types" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    {
      "type": "select",
      "id": "padding",
      "label": "Khoảng đệm dọc",
      "options": [
        { "value": "none", "label": "Gọn" },
        { "value": "normal", "label": "Bình thường" }
      ],
      "default": "normal"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "return", "label": "Return (guarantee)" },
            { "value": "padlock", "label": "Padlock (secure)" },
            { "value": "chat_bubble", "label": "Chat (support)" },
            { "value": "heart", "label": "Heart" },
            { "value": "check_mark", "label": "Check" },
            { "value": "star", "label": "Star" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "On orders over $40" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "truck", "title": "Free Shipping", "subtitle": "On orders over $40" } },
        { "type": "badge", "settings": { "icon": "return", "title": "30-Day Guarantee", "subtitle": "Love it or get a full refund" } },
        { "type": "badge", "settings": { "icon": "padlock", "title": "Secure Checkout", "subtitle": "100% safe & encrypted" } },
        { "type": "badge", "settings": { "icon": "chat_bubble", "title": "24/7 Support", "subtitle": "We're here anytime" } }
      ]
    }
  ]
}
{% endschema %}
