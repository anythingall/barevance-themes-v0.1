{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when settings.store_type is not in this section's type_visibility. Falls back to showing everything if store_type is blank. {%- endcomment -%}
{%- liquid
  assign hl_hide = false
  assign hl_vis = section.settings.type_visibility | default: 'all'
  assign hl_st = settings.store_type | default: 'v1'
  assign hl_on = false
  if template.name == 'index'
    assign hl_on = true
  endif
  if template.name == 'product'
    assign hl_on = true
  endif
  if hl_on and hl_vis != 'all'
    unless hl_vis contains hl_st
      assign hl_hide = true
    endunless
  endif
-%}
{%- unless hl_hide -%}
{%- comment -%}
  vy-comparison-table — "Us vs others" comparison (mobile-first).
  Rows of feature + our value + competitor value. Mobile: table scrolls horizontally
  and the first column stays readable.
{%- endcomment -%}

<div class="vy-compare color-{{ section.settings.color_scheme }} gradient vy-section">
  <div class="vy-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="vy-h2 vy-compare__heading" style="text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.mode == 'models' -%}
      <div class="vy-table-scroll" tabindex="0" role="region" aria-label="Comparison table (scroll horizontally)">
        <table class="vy-compare__table vy-compare__table--models">
          <thead>
            <tr>
              <th class="vy-compare__feature-col" scope="col">{{ section.settings.feature_label }}</th>
              {%- for i in (1..4) -%}
                {%- assign k_name = 'col' | append: i | append: '_name' -%}
                {%- assign k_img = 'col' | append: i | append: '_image' -%}
                {%- assign k_hl = 'col' | append: i | append: '_highlight' -%}
                {%- assign cname = section.settings[k_name] -%}
                {%- assign cimg = section.settings[k_img] -%}
                {%- assign chl = section.settings[k_hl] -%}
                {%- if cname != blank -%}
                  <th class="vy-compare__model{% if chl %} is-highlight{% endif %}" scope="col">
                    {%- if cimg != blank -%}
                      <span class="vy-compare__model-img"><img src="{{ cimg }}" width="120" height="120" loading="lazy" alt="{{ cname | escape }}"></span>
                    {%- endif -%}
                    <span class="vy-compare__model-name">{{ cname }}</span>
                  </th>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'model_row' -%}
                <tr {{ block.shopify_attributes }}>
                  <th class="vy-compare__feature" scope="row">{{ block.settings.feature }}</th>
                  {%- for i in (1..4) -%}
                    {%- assign k_name = 'col' | append: i | append: '_name' -%}
                    {%- assign cname = section.settings[k_name] -%}
                    {%- if cname != blank -%}
                      {%- assign k_r = 'r' | append: i -%}
                      {%- assign k_hl = 'col' | append: i | append: '_highlight' -%}
                      {%- assign rating = block.settings[k_r] | default: 0 -%}
                      {%- assign chl = section.settings[k_hl] -%}
                      <td class="vy-compare__rating{% if chl %} is-highlight{% endif %}">
                        {%- if section.settings.mark_style == 'checks' -%}
                          {%- if rating >= 3 -%}
                            {%- render 'custom-compare-mark', state: 'check' -%}
                          {%- else -%}
                            <span class="vy-compare__dash" role="img" aria-label="not included">—</span>
                          {%- endif -%}
                        {%- else -%}
                          <span class="vy-compare__stars" role="img" aria-label="{{ rating }} out of 5">
                            {%- for s in (1..5) -%}
                              <span class="vy-compare__star{% if s <= rating %} is-on{% endif %}" aria-hidden="true">★</span>
                            {%- endfor -%}
                          </span>
                        {%- endif -%}
                      </td>
                    {%- endif -%}
                  {%- endfor -%}
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- else -%}
    <div class="vy-compare__layout {% if section.settings.image != blank %}has-image{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="vy-compare__media vy-card">
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'vy-compare__img', alt: section.settings.heading }}
        </div>
      {%- endif -%}
      <div class="vy-table-scroll" tabindex="0" role="region" aria-label="Comparison table (scroll horizontally)">
      <table class="vy-compare__table">
        <thead>
          <tr>
            <th class="vy-compare__feature-col" scope="col">{{ section.settings.feature_label }}</th>
            <th class="vy-compare__us-col" scope="col">{{ section.settings.us_label }}</th>
            <th scope="col">{{ section.settings.others_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
            <tr {{ block.shopify_attributes }}>
              <th class="vy-compare__feature" scope="row">{{ block.settings.feature }}</th>
              <td class="vy-compare__us">
                {%- render 'custom-compare-mark', state: block.settings.us -%}
              </td>
              <td class="vy-compare__other">
                {%- render 'custom-compare-mark', state: block.settings.others -%}
              </td>
            </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>

{%- else -%}{%- if request.design_mode -%}<div class="vy-hidden-note" style="padding:1.2rem 1.6rem;margin:0.4rem auto;max-width:60rem;border:0.1rem dashed rgba(128,128,128,0.55);border-radius:0.6rem;font-size:1.3rem;text-align:center;opacity:0.85;">Hidden on the current Store type (<b>{{ settings.store_type | default: 'v1' | upcase }}</b>). Shows on: <b>{{ section.settings.type_visibility | default: 'all' | upcase }}</b>. Change “Store type” in Theme settings, or this section’s “Show on store type”.</div>{%- endif -%}{%- endunless -%}

{% stylesheet %}
  .vy-compare__heading {
    margin: 0 0 2.4rem;
  }

  .vy-compare__layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .vy-compare__media {
    aspect-ratio: 4 / 3;
  }

  .vy-compare__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (min-width: 990px) {
    .vy-compare__layout.has-image {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
    }

    .vy-compare__layout.has-image .vy-compare__media {
      flex: 0 0 38%;
      aspect-ratio: 3 / 4;
    }

    .vy-compare__layout.has-image .vy-table-scroll {
      flex: 1;
    }
  }

  .vy-compare__table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
  }

  .vy-compare__table th,
  .vy-compare__table td {
    padding: 1.2rem 1.4rem;
    text-align: center;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }

  .vy-compare__table th {
    font-weight: 700;
    font-size: 1.5rem;
  }

  /* Body row-label cells are <th scope="row"> for a11y; keep them visually
     identical to the data cells (not bold like column headers). */
  .vy-compare__table tbody th.vy-compare__feature {
    font-weight: 400;
    font-size: 1.5rem;
  }

  .vy-compare__feature-col,
  .vy-compare__feature {
    text-align: left;
    position: sticky;
    left: 0;
    background: rgb(var(--color-background));
  }

  .vy-compare__us-col,
  .vy-compare__us {
    background: rgba(var(--color-button), 0.08);
  }

  .vy-compare__us-col {
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  .vy-compare__table .svg-wrapper {
    width: 2rem;
    height: 2rem;
  }

  /* ---- Models mode: feature + up to 4 model columns with star ratings ---- */
  .vy-compare__table--models {
    min-width: 56rem;
  }

  .vy-compare__table--models th,
  .vy-compare__table--models td {
    padding: 1.4rem 1.2rem;
  }

  .vy-compare__model {
    vertical-align: bottom;
  }

  .vy-compare__model-img {
    display: block;
    width: 6rem;
    height: 6rem;
    margin: 0 auto 0.8rem;
    border-radius: 1.2rem;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.06);
  }

  .vy-compare__model-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vy-compare__model-name {
    font-weight: 700;
    font-size: 1.5rem;
  }

  .vy-compare__stars {
    display: inline-flex;
    gap: 0.15rem;
    font-size: 1.5rem;
    line-height: 1;
    color: rgba(var(--color-foreground), 0.18);
  }

  .vy-compare__star.is-on {
    color: #d99124;
  }

  .vy-compare__dash {
    color: rgba(var(--color-foreground), 0.3);
    font-size: 1.6rem;
  }

  /* Highlighted (recommended) model column */
  .vy-compare__model.is-highlight,
  .vy-compare__rating.is-highlight {
    background: rgba(var(--color-button), 0.08);
  }

  .vy-compare__table--models thead .vy-compare__model.is-highlight {
    border-top-left-radius: 1.2rem;
    border-top-right-radius: 1.2rem;
    box-shadow: inset 0 0.2rem 0 0 rgb(var(--color-button)), inset 0.2rem 0 0 0 rgb(var(--color-button)), inset -0.2rem 0 0 0 rgb(var(--color-button));
  }

  .vy-compare__table--models tbody tr:last-child .vy-compare__rating.is-highlight {
    box-shadow: inset 0 -0.2rem 0 0 rgb(var(--color-button)), inset 0.2rem 0 0 0 rgb(var(--color-button)), inset -0.2rem 0 0 0 rgb(var(--color-button));
  }

  .vy-compare__table--models tbody tr:not(:last-child) .vy-compare__rating.is-highlight {
    box-shadow: inset 0.2rem 0 0 0 rgb(var(--color-button)), inset -0.2rem 0 0 0 rgb(var(--color-button));
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "vy-compare-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All layouts" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "Ảnh sản phẩm (bên trái, tuỳ chọn)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Us Over Others?" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "feature_label", "label": "Cột đặc điểm", "default": "Features" },
    {
      "type": "select",
      "id": "mode",
      "label": "Kiểu bảng",
      "options": [
        { "value": "vs", "label": "Us vs Others (2 cột)" },
        { "value": "models", "label": "So sánh model (4 cột)" }
      ],
      "default": "vs"
    },
    {
      "type": "select",
      "id": "mark_style",
      "label": "Kiểu đánh dấu (models)",
      "options": [
        { "value": "stars", "label": "Sao (0–5)" },
        { "value": "checks", "label": "Tick ✓ / —" }
      ],
      "default": "stars"
    },
    { "type": "header", "content": "Us vs Others (kiểu 'vs')" },
    { "type": "text", "id": "us_label", "label": "Cột của bạn", "default": "Our Brand" },
    { "type": "text", "id": "others_label", "label": "Cột đối thủ", "default": "Others" },
    { "type": "header", "content": "Cột model (kiểu 'models')" },
    { "type": "text", "id": "col1_name", "label": "Model 1 — tên" },
    { "type": "text", "id": "col1_image", "label": "Model 1 — ảnh (URL)" },
    { "type": "checkbox", "id": "col1_highlight", "label": "Model 1 — nổi bật", "default": true },
    { "type": "text", "id": "col2_name", "label": "Model 2 — tên" },
    { "type": "text", "id": "col2_image", "label": "Model 2 — ảnh (URL)" },
    { "type": "checkbox", "id": "col2_highlight", "label": "Model 2 — nổi bật", "default": false },
    { "type": "text", "id": "col3_name", "label": "Model 3 — tên" },
    { "type": "text", "id": "col3_image", "label": "Model 3 — ảnh (URL)" },
    { "type": "checkbox", "id": "col3_highlight", "label": "Model 3 — nổi bật", "default": false },
    { "type": "text", "id": "col4_name", "label": "Model 4 — tên" },
    { "type": "text", "id": "col4_image", "label": "Model 4 — ảnh (URL)" },
    { "type": "checkbox", "id": "col4_highlight", "label": "Model 4 — nổi bật", "default": false }
  ],
  "blocks": [
    {
      "type": "model_row",
      "name": "Model row (rating)",
      "settings": [
        { "type": "text", "id": "feature", "label": "Đặc điểm", "default": "Everyday" },
        { "type": "range", "id": "r1", "label": "Model 1 sao", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "range", "id": "r2", "label": "Model 2 sao", "min": 0, "max": 5, "step": 1, "default": 4 },
        { "type": "range", "id": "r3", "label": "Model 3 sao", "min": 0, "max": 5, "step": 1, "default": 4 },
        { "type": "range", "id": "r4", "label": "Model 4 sao", "min": 0, "max": 5, "step": 1, "default": 3 }
      ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Đặc điểm", "default": "Premium quality" },
        {
          "type": "select",
          "id": "us",
          "label": "Của bạn",
          "options": [
            { "value": "check", "label": "✓ Có" },
            { "value": "partial", "label": "△ Một phần" },
            { "value": "cross", "label": "✗ Không" }
          ],
          "default": "check"
        },
        {
          "type": "select",
          "id": "others",
          "label": "Đối thủ",
          "options": [
            { "value": "check", "label": "✓ Có" },
            { "value": "partial", "label": "△ Một phần" },
            { "value": "cross", "label": "✗ Không" }
          ],
          "default": "cross"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Premium quality", "us": "check", "others": "cross" } },
        { "type": "row", "settings": { "feature": "Lightweight & portable", "us": "check", "others": "partial" } },
        { "type": "row", "settings": { "feature": "Durable & long-lasting", "us": "check", "others": "cross" } },
        { "type": "row", "settings": { "feature": "Easy to clean", "us": "check", "others": "partial" } }
      ]
    }
  ]
}
{% endschema %}
