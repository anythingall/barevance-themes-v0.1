{%- comment -%}
  custom-pricing-tiers — Quantity / "buy more save more" offers for One Product stores.
  Each tier adds a real product with a chosen quantity + an optional per-tier discount %.

  IMPORTANT: the per-tier "discount %" is a DISPLAY value. The real discount must be set
  up as an Automatic discount in Shopify Admin (e.g. "buy 2 → 10% off", "buy 3 → 15%",
  "buy 4 → 20%") so it actually applies at checkout and shows in the cart drawer. Keep the
  tier % here in sync with the Admin discount. When discount % is 0, the tier falls back to
  the product's compare-at price. No hard-coded prices.
{%- endcomment -%}

<div class="custom-tiers color-{{ section.settings.color_scheme }} gradient custom-section">
  <div class="custom-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-h2 custom-tiers__heading" style="text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="custom-tiers__grid" style="--tier-cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign qty = block.settings.quantity | at_least: 1
          assign variant = product.selected_or_first_available_variant
          assign unit_price = variant.price | default: product.price
          assign base_total = unit_price | times: qty
          assign discount = block.settings.discount_percent | default: 0

          if discount > 0
            assign keep = 100 | minus: discount
            assign pay_total = base_total | times: keep | divided_by: 100
            assign orig_total = base_total
            assign save_pct = discount
          else
            assign compare = variant.compare_at_price | default: product.compare_at_price
            assign pay_total = base_total
            assign orig_total = compare | times: qty
            assign save_pct = 0
            if orig_total > pay_total
              assign save_pct = orig_total | minus: pay_total | times: 100 | divided_by: orig_total
            endif
          endif

          assign per_unit = pay_total | divided_by: qty
        -%}
        <div class="custom-tiers__card custom-card {% if block.settings.highlight %}is-highlight{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="custom-tiers__badge">{{ block.settings.badge }}</span>
          {%- endif -%}

          <div class="custom-tiers__card-top">
            <a href="{{ product.url | default: '#' }}" class="custom-tiers__media" aria-label="{{ product.title | default: block.settings.label }}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'custom-tiers__img', alt: block.settings.label }}
              {%- elsif product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'custom-tiers__img', alt: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'custom-tiers__img placeholder-svg' }}
              {%- endif -%}
            </a>

            <div class="custom-tiers__info">
              <h3 class="custom-tiers__label">
                <a href="{{ product.url | default: '#' }}" class="custom-tiers__label-link">{{ block.settings.label | default: product.title }}</a>
              </h3>

              <div class="custom-tiers__price">
                <span class="custom-tiers__price-now">{{ pay_total | money }}</span>
                {%- if orig_total > pay_total -%}
                  <s class="custom-tiers__price-was">{{ orig_total | money }}</s>
                {%- endif -%}
              </div>

              {%- if qty > 1 -%}
                <span class="custom-tiers__unit">{{ per_unit | money }} each</span>
              {%- endif -%}

              {%- if save_pct > 0 -%}
                <span class="custom-tiers__save">Save {{ save_pct }}%</span>
              {%- endif -%}
            </div>
          </div>

          {%- if product != blank and variant != blank -%}
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="custom-tiers__form">
              <input type="hidden" name="id" value="{{ variant.id }}">
              <input type="hidden" name="quantity" value="{{ qty }}">
              <button
                type="submit"
                name="add"
                class="button custom-cta {% if block.settings.highlight %}button--primary{% else %}button--secondary{% endif %}"
                {% unless variant.available %}disabled{% endunless %}
              >
                {%- if variant.available -%}
                  {{ section.settings.button_label }}
                {%- else -%}
                  Sold out
                {%- endif -%}
              </button>
            </form>
          {%- else -%}
            <p class="custom-tiers__empty">Chọn product cho tier này.</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-tiers__heading {
    margin: 0 0 2.8rem;
  }

  .custom-tiers__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  .custom-tiers__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    text-align: left;
    padding: 2.4rem 1.8rem 1.8rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    background: rgb(var(--color-background));
  }

  .custom-tiers__card.is-highlight {
    border-color: rgb(var(--color-button));
    border-width: 0.2rem;
  }

  .custom-tiers__card-top {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .custom-tiers__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .custom-tiers__badge {
    position: absolute;
    top: -1.1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .custom-tiers__media {
    display: block;
    width: 8.5rem;
    flex: 0 0 8.5rem;
    aspect-ratio: 1 / 1;
  }

  .custom-tiers__label-link {
    color: inherit;
    text-decoration: none;
  }

  .custom-tiers__label-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .custom-tiers__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 0.8rem;
  }

  .custom-tiers__label {
    margin: 0;
    font-size: 1.7rem;
  }

  .custom-tiers__price {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .custom-tiers__price-now {
    font-size: 2.4rem;
    font-weight: 700;
  }

  .custom-tiers__price-was {
    opacity: 0.55;
  }

  .custom-tiers__unit {
    font-size: 1.2rem;
    opacity: 0.7;
  }

  .custom-tiers__save {
    color: rgb(var(--color-button-text));
    background: rgb(var(--color-button));
    font-weight: 700;
    font-size: 1.2rem;
    padding: 0.3rem 1rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .custom-tiers__form {
    width: 100%;
    margin-top: 0.8rem;
  }

  .custom-tiers__form .custom-cta {
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .custom-tiers__grid {
      grid-template-columns: repeat(var(--tier-cols, 3), 1fr);
      align-items: center;
    }

    .custom-tiers__card.is-highlight {
      box-shadow: 0 1.2rem 3.2rem rgba(0, 0, 0, 0.14);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Pricing tiers",
  "tag": "section",
  "class": "custom-tiers-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose Your Set" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "button_label", "label": "Nút", "default": "Add to Cart" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "quantity", "label": "Số lượng thêm vào giỏ", "min": 1, "max": 10, "step": 1, "default": 1 },
        {
          "type": "range",
          "id": "discount_percent",
          "label": "Giảm giá tier này (%)",
          "info": "Phải khớp Automatic discount trong Admin (vd buy 2 → 10%). 0 = dùng compare-at price.",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        { "type": "text", "id": "label", "label": "Nhãn tier", "default": "1 × Product" },
        { "type": "text", "id": "badge", "label": "Badge (vd MOST POPULAR)" },
        { "type": "checkbox", "id": "highlight", "label": "Nổi bật tier này", "default": false },
        { "type": "image_picker", "id": "image", "label": "Ảnh riêng (tuỳ chọn)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing tiers",
      "blocks": [
        { "type": "tier", "settings": { "quantity": 1, "label": "1 × Product", "discount_percent": 0 } },
        { "type": "tier", "settings": { "quantity": 2, "label": "2 × Product", "badge": "MOST POPULAR", "highlight": true, "discount_percent": 10 } },
        { "type": "tier", "settings": { "quantity": 3, "label": "3 × Product", "discount_percent": 15 } },
        { "type": "tier", "settings": { "quantity": 4, "label": "4 × Product", "discount_percent": 20 } }
      ]
    }
  ]
}
{% endschema %}
