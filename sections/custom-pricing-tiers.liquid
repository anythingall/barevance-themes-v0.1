{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when settings.store_type is not in this section's type_visibility. Falls back to showing everything if store_type is blank. {%- endcomment -%}
{%- liquid
  assign hl_hide = false
  assign hl_vis = section.settings.type_visibility | default: 'all'
  assign hl_st = settings.store_type | default: 'v1'
  assign hl_on = false
  if template.name == 'index'
    assign hl_on = true
  endif
  if template.name == 'product'
    assign hl_on = true
  endif
  if hl_on and hl_vis != 'all'
    unless hl_vis contains hl_st
      assign hl_hide = true
    endunless
  endif
-%}
{%- unless hl_hide -%}
{%- comment -%}
  vy-pricing-tiers — Quantity / "buy more save more" offers for One Product stores.
  Each tier adds a real product with a chosen quantity + an optional per-tier discount %.

  IMPORTANT: the per-tier "discount %" is a DISPLAY value. The real discount must be set
  up as an Automatic discount in Shopify Admin (e.g. "buy 2 → 10% off", "buy 3 → 15%",
  "buy 4 → 20%") so it actually applies at checkout and shows in the cart drawer. Keep the
  tier % here in sync with the Admin discount. When discount % is 0, the tier falls back to
  the product's compare-at price. No hard-coded prices.
{%- endcomment -%}

{%- render 'custom-cart-ajax' -%}
{%- assign tiers_split = false -%}
{%- if section.settings.layout == 'split' -%}{%- assign tiers_split = true -%}{%- endif -%}
<div class="vy-tiers color-{{ section.settings.color_scheme }} gradient vy-section{% if tiers_split %} vy-tiers--split{% endif %}">
  <div class="vy-container">
    {%- if tiers_split -%}
      <div class="vy-tiers__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="vy-h2 vy-tiers__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vy-tiers__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="button button--primary vy-cta vy-tiers__cta" href="{{ section.settings.cta_link | default: '#' }}">
            {{ section.settings.button_label }}
            <span class="vy-tiers__cta-arrow" aria-hidden="true">{%- render 'custom-icon', icon: 'arrow' -%}</span>
          </a>
        {%- endif -%}
      </div>
    {%- elsif section.settings.heading != blank -%}
      <h2 class="vy-h2 vy-tiers__heading" style="text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- comment -%} On a product page, tiers with no product of their own fall back to the current product. {%- endcomment -%}
    {%- assign vy_page_product = product -%}
    <div class="vy-tiers__grid" style="--tier-cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product | default: vy_page_product
          assign qty = block.settings.quantity | at_least: 1
          assign variant = product.selected_or_first_available_variant
          assign unit_price = variant.price | default: product.price
          assign base_total = unit_price | times: qty
          assign discount = block.settings.discount_percent | default: 0

          if discount > 0
            assign keep = 100 | minus: discount
            assign pay_total = base_total | times: keep | divided_by: 100
            assign orig_total = base_total
            assign save_pct = discount
          else
            assign compare = variant.compare_at_price | default: product.compare_at_price
            assign pay_total = base_total
            assign orig_total = compare | times: qty
            assign save_pct = 0
            if orig_total > pay_total
              assign save_pct = orig_total | minus: pay_total | times: 100 | divided_by: orig_total
            endif
          endif

          assign per_unit = pay_total | divided_by: qty
        -%}
        <div class="vy-tiers__card vy-card {% if block.settings.highlight %}is-highlight{% endif %}" {{ block.shopify_attributes }}>
          {%- unless tiers_split -%}
            {%- if block.settings.badge != blank -%}
              <span class="vy-tiers__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
          {%- endunless -%}

          {%- if tiers_split -%}
            <div class="vy-tiers__head">
              <span class="vy-tiers__num" aria-hidden="true">{{ forloop.index }}</span>
              <span class="vy-tiers__head-main">
                <h3 class="vy-tiers__label">{{ block.settings.label | default: product.title }}</h3>
                {%- if block.settings.badge != blank -%}
                  <span class="vy-tiers__badge vy-tiers__badge--inline">{{ block.settings.badge }}</span>
                {%- endif -%}
              </span>
            </div>
            <div class="vy-tiers__media vy-tiers__media--stack">
              {%- if block.settings.image_url != blank -%}
                <img class="vy-tiers__img" src="{{ block.settings.image_url }}" width="300" height="240" loading="lazy" alt="{{ block.settings.label | escape }}">
                {%- if block.settings.image_url2 != blank -%}
                  <img class="vy-tiers__img vy-tiers__img--2" src="{{ block.settings.image_url2 }}" width="300" height="240" loading="lazy" alt="">
                {%- endif -%}
                {%- if block.settings.image_url3 != blank -%}
                  <img class="vy-tiers__img vy-tiers__img--3" src="{{ block.settings.image_url3 }}" width="300" height="240" loading="lazy" alt="">
                {%- endif -%}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'vy-tiers__img', alt: block.settings.label }}
              {%- elsif product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'vy-tiers__img', alt: product.title }}
              {%- endif -%}
            </div>
            <div class="vy-tiers__price">
              <span class="vy-tiers__price-now">
                {%- if block.settings.price_text != blank -%}{{ block.settings.price_text }}{%- else -%}{{ pay_total | money }}{%- endif -%}
              </span>
            </div>
            {%- if block.settings.save_text != blank -%}
              <span class="vy-tiers__save {% if block.settings.save_text contains 'Save' or block.settings.save_text contains 'save' %}is-save{% endif %}">{{ block.settings.save_text }}</span>
            {%- endif -%}
          {%- else -%}
          <div class="vy-tiers__card-top">
            <a href="{{ product.url | default: '#' }}" class="vy-tiers__media" aria-label="{{ product.title | default: block.settings.label }}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'vy-tiers__img', alt: block.settings.label }}
              {%- elsif product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'vy-tiers__img', alt: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'vy-tiers__img placeholder-svg' }}
              {%- endif -%}
            </a>

            <div class="vy-tiers__info">
              <h3 class="vy-tiers__label">
                <a href="{{ product.url | default: '#' }}" class="vy-tiers__label-link">{{ block.settings.label | default: product.title }}</a>
              </h3>

              <div class="vy-tiers__price">
                <span class="vy-tiers__price-now">{{ pay_total | money }}</span>
                {%- if orig_total > pay_total -%}
                  <s class="vy-tiers__price-was">{{ orig_total | money }}</s>
                {%- endif -%}
              </div>

              {%- if qty > 1 -%}
                <span class="vy-tiers__unit">{{ per_unit | money }} each</span>
              {%- endif -%}

              {%- if save_pct > 0 -%}
                <span class="vy-tiers__save">Save {{ save_pct }}%</span>
              {%- endif -%}
            </div>
          </div>
          {%- endif -%}

          {%- if tiers_split -%}
          {%- elsif product != blank and variant != blank -%}
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="vy-tiers__form" data-ajax-cart>
              <input type="hidden" name="id" value="{{ variant.id }}">
              <input type="hidden" name="quantity" value="{{ qty }}">
              <button
                type="submit"
                name="add"
                class="button vy-cta {% if block.settings.highlight %}button--primary{% else %}button--secondary{% endif %}"
                {% unless variant.available %}disabled{% endunless %}
              >
                {%- if variant.available -%}
                  {{ section.settings.button_label }}
                {%- else -%}
                  Sold out
                {%- endif -%}
              </button>
            </form>
          {%- else -%}
            <p class="vy-tiers__empty">Chọn product cho tier này.</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- else -%}{%- if request.design_mode -%}<div class="vy-hidden-note" style="padding:1.2rem 1.6rem;margin:0.4rem auto;max-width:60rem;border:0.1rem dashed rgba(128,128,128,0.55);border-radius:0.6rem;font-size:1.3rem;text-align:center;opacity:0.85;">Hidden on the current Store type (<b>{{ settings.store_type | default: 'v1' | upcase }}</b>). Shows on: <b>{{ section.settings.type_visibility | default: 'all' | upcase }}</b>. Change “Store type” in Theme settings, or this section’s “Show on store type”.</div>{%- endif -%}{%- endunless -%}

{% stylesheet %}
  .vy-tiers__heading {
    margin: 0 0 2.8rem;
  }

  .vy-tiers__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  .vy-tiers__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    text-align: left;
    padding: 2.4rem 1.8rem 1.8rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    background: rgb(var(--color-background));
    border-radius: var(--vy-card-radius, 0);
    overflow: visible; /* let the "MOST POPULAR" badge sit above the card */
  }

  .vy-tiers__card.is-highlight {
    border-color: rgb(var(--color-accent-strong, var(--color-button)));
    border-width: 0.2rem;
  }

  .vy-tiers__card-top {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .vy-tiers__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .vy-tiers__badge {
    position: absolute;
    top: -1.1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .vy-tiers__media {
    display: block;
    width: 8.5rem;
    flex: 0 0 8.5rem;
    aspect-ratio: 1 / 1;
    overflow: hidden; /* card is overflow:visible now — clip the image here instead */
    border-radius: 0.8rem;
  }

  .vy-tiers__label-link {
    color: inherit;
    text-decoration: none;
  }

  .vy-tiers__label-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .vy-tiers__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 0.8rem;
  }

  .vy-tiers__label {
    margin: 0;
    font-size: 1.7rem;
  }

  .vy-tiers__price {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .vy-tiers__price-now {
    font-size: 2.4rem;
    font-weight: 700;
  }

  .vy-tiers__price-was {
    opacity: 0.72;
  }

  .vy-tiers__unit {
    font-size: 1.2rem;
    opacity: 0.9;
  }

  .vy-tiers__save {
    color: rgb(var(--color-button-text));
    background: rgb(var(--color-button));
    font-weight: 700;
    font-size: 1.2rem;
    padding: 0.3rem 1rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .vy-tiers__form {
    width: 100%;
    margin-top: auto; /* push CTA to the bottom so every tier's button lines up */
    padding-top: 0.8rem;
  }

  .vy-tiers__form .vy-cta {
    width: 100%;
  }

  /* Split layout: left intro + single CTA, right tier tiles (matches Voya design) */
  .vy-tiers--split.vy-section {
    background: rgb(var(--brand-sand, 246, 241, 231));
  }
  .vy-tiers__intro { margin-bottom: 2.4rem; }
  .vy-tiers--split .vy-tiers__heading { margin: 0 0 1rem; text-wrap: balance; font-size: calc(3.2rem * var(--font-heading-scale, 1)); line-height: 1.15; }
  .vy-tiers__cta-arrow { display: inline-flex; margin-left: 0.6rem; }
  .vy-tiers__cta-arrow .svg-wrapper,
  .vy-tiers__cta-arrow svg { width: 1.5rem; height: 1.5rem; }
  .vy-tiers__sub { margin: 0 0 1.8rem; font-size: 1.5rem; opacity: 0.82; max-width: 34rem; }
  .vy-tiers__cta { display: inline-flex; }

  @media screen and (min-width: 750px) {
    .vy-tiers__grid {
      grid-template-columns: repeat(var(--tier-cols, 3), 1fr);
      align-items: stretch; /* equal-height cards so CTAs align */
    }

    .vy-tiers__card.is-highlight {
      box-shadow: 0 1.2rem 3.2rem rgba(0, 0, 0, 0.14);
    }
  }

  @media screen and (min-width: 990px) {
    .vy-tiers--split .vy-container {
      display: grid;
      grid-template-columns: 1.1fr 1.8fr;
      gap: 3.2rem;
      align-items: center;
    }
    .vy-tiers--split .vy-tiers__intro { margin-bottom: 0; }
  }

  /* Split promo tiles — design parity (white card, grey image box, green price,
     plain-text savings, green Best Value badge). */
  .vy-tiers--split .vy-tiers__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    background: rgb(var(--brand-bg, 255, 255, 255));
    border: 0.1rem solid rgba(var(--color-foreground), 0.06);
    border-radius: 1.4rem;
    padding: 1.8rem 1.6rem;
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.06);
  }

  .vy-tiers--split .vy-tiers__media {
    background: rgba(var(--color-foreground), 0.04);
  }

  .vy-tiers--split .vy-tiers__head {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 2rem;
  }

  .vy-tiers--split .vy-tiers__num {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 1.3rem;
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.4);
  }

  .vy-tiers--split .vy-tiers__label {
    font-size: 1.6rem;
    font-weight: 700;
  }

  .vy-tiers--split .vy-tiers__media {
    width: 100%;
    flex: none;
    aspect-ratio: 16 / 10;
    background: rgba(var(--color-foreground), 0.05);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .vy-tiers--split .vy-tiers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1rem;
  }

  .vy-tiers--split .vy-tiers__price {
    justify-content: center;
  }

  .vy-tiers--split .vy-tiers__price-now {
    color: rgb(var(--brand-primary, 35, 69, 45));
    font-size: 2.2rem;
    font-weight: 800;
  }

  .vy-tiers--split .vy-tiers__save {
    background: transparent;
    color: rgba(var(--color-foreground), 0.65);
    padding: 0;
    border-radius: 0;
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: 0;
  }

  .vy-tiers--split .vy-tiers__save.is-save {
    color: rgb(var(--brand-primary, 35, 69, 45));
    font-weight: 600;
  }

  .vy-tiers--split .vy-tiers__head-main {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .vy-tiers__badge--inline {
    position: static;
    transform: none;
    background: rgb(var(--brand-primary, 35, 69, 45));
    color: #fff;
    text-transform: none;
    letter-spacing: 0;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.3rem 0.9rem;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Pricing tiers",
  "tag": "section",
  "class": "vy-tiers-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All layouts" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid (nút mỗi tier)" },
        { "value": "split", "label": "Split (intro trái + tiles phải)" }
      ],
      "default": "grid"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose Your Set" },
    { "type": "textarea", "id": "subheading", "label": "Subheading (split)", "default": "Mix colors and styles for your lifestyle." },
    { "type": "url", "id": "cta_link", "label": "CTA link (split)" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "button_label", "label": "Nút", "default": "Add to Cart" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "quantity", "label": "Số lượng thêm vào giỏ", "min": 1, "max": 10, "step": 1, "default": 1 },
        {
          "type": "range",
          "id": "discount_percent",
          "label": "Giảm giá tier này (%)",
          "info": "Display only — must match an Automatic discount in Admin → Discounts (e.g. buy 2 → 10%), or checkout won't apply it. Run bootstrap-store.mjs with BOOTSTRAP_QTY_DISCOUNTS=1 to create the matching buy-2/3/4 discounts. 0 = use the product's compare-at price instead.",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        { "type": "text", "id": "label", "label": "Nhãn tier", "default": "1 × Product" },
        { "type": "text", "id": "badge", "label": "Badge (vd MOST POPULAR)" },
        { "type": "checkbox", "id": "highlight", "label": "Nổi bật tier này", "default": false },
        { "type": "image_picker", "id": "image", "label": "Ảnh riêng (tuỳ chọn)" },
        { "type": "header", "content": "Split layout (promo tiles)" },
        { "type": "text", "id": "price_text", "label": "Giá hiển thị (vd $79.99)" },
        { "type": "text", "id": "save_text", "label": "Dòng phụ (vd Standard / Save $19.99)" },
        { "type": "text", "id": "image_url", "label": "Ảnh 1 (URL CDN)" },
        { "type": "text", "id": "image_url2", "label": "Ảnh 2 (URL CDN)" },
        { "type": "text", "id": "image_url3", "label": "Ảnh 3 (URL CDN)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing tiers",
      "blocks": [
        { "type": "tier", "settings": { "quantity": 1, "label": "1 × Product", "discount_percent": 0 } },
        { "type": "tier", "settings": { "quantity": 2, "label": "2 × Product", "badge": "MOST POPULAR", "highlight": true, "discount_percent": 10 } },
        { "type": "tier", "settings": { "quantity": 3, "label": "3 × Product", "discount_percent": 15 } },
        { "type": "tier", "settings": { "quantity": 4, "label": "4 × Product", "discount_percent": 20 } }
      ]
    }
  ]
}
{% endschema %}
