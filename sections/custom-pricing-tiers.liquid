{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when settings.store_type is not in this section's type_visibility. Falls back to showing everything if store_type is blank. {%- endcomment -%}
{%- liquid
  assign hl_hide = false
  assign hl_vis = section.settings.type_visibility | default: 'all'
  assign hl_st = settings.store_type | default: 'v1'
  assign hl_on = false
  if template.name == 'index'
    assign hl_on = true
  endif
  if template.name == 'product'
    assign hl_on = true
  endif
  if hl_on and hl_vis != 'all'
    unless hl_vis contains hl_st
      assign hl_hide = true
    endunless
  endif
-%}
{%- unless hl_hide -%}
{%- comment -%}
  vy-pricing-tiers — Quantity / "buy more save more" offers for One Product stores.
  Each tier adds a real product with a chosen quantity + an optional per-tier discount %.

  IMPORTANT: the per-tier "discount %" is a DISPLAY value. The real discount must be set
  up as an Automatic discount in Shopify Admin (e.g. "buy 2 → 10% off", "buy 3 → 15%",
  "buy 4 → 20%") so it actually applies at checkout and shows in the cart drawer. Keep the
  tier % here in sync with the Admin discount. When discount % is 0, the tier falls back to
  the product's compare-at price. No hard-coded prices.
{%- endcomment -%}

{%- render 'custom-cart-ajax' -%}
{%- assign tiers_split = false -%}
{%- if section.settings.layout == 'split' -%}{%- assign tiers_split = true -%}{%- endif -%}
{%- assign vy_page_product = product -%}
{%- assign vy_buyable = false -%}
{%- if tiers_split and section.settings.split_buyable -%}{%- assign vy_buyable = true -%}{%- endif -%}
{%- assign vy_def_bidx = 0 -%}
{%- assign vy_has_hl = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.highlight -%}{%- assign vy_def_bidx = forloop.index0 -%}{%- assign vy_has_hl = true -%}{%- endif -%}
{%- endfor -%}
{%- unless vy_has_hl -%}{%- assign vy_def_bidx = section.blocks.size | minus: 1 -%}{%- endunless -%}
{%- assign vy_def_vid = '' -%}{%- assign vy_def_qty = 1 -%}{%- assign vy_def_avail = false -%}
{%- for block in section.blocks -%}
  {%- if forloop.index0 == vy_def_bidx -%}
    {%- assign vy_dp = block.settings.product | default: vy_page_product -%}
    {%- assign vy_def_qty = block.settings.quantity | at_least: 1 -%}
    {%- assign vy_dv = vy_dp.selected_or_first_available_variant -%}
    {%- assign vy_def_vid = vy_dv.id -%}
    {%- assign vy_def_avail = vy_dv.available -%}
  {%- endif -%}
{%- endfor -%}
<div id="vy-tiers-{{ section.id }}" class="vy-tiers color-{{ section.settings.color_scheme }} gradient vy-section{% if tiers_split %} vy-tiers--split{% endif %}{% if vy_buyable %} vy-tiers--buyable{% endif %}">
  <div class="vy-container">
    {%- if tiers_split -%}
      <div class="vy-tiers__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="vy-h2 vy-tiers__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vy-tiers__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if vy_buyable -%}
          <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="vy-tiers__buyform" data-ajax-cart data-tiers-form>
            <input type="hidden" name="id" value="{{ vy_def_vid }}" data-tiers-id>
            <input type="hidden" name="quantity" value="{{ vy_def_qty }}" data-tiers-qty>
            <button type="submit" name="add" class="button button--primary vy-cta vy-tiers__cta" data-tiers-add {% unless vy_def_avail %}disabled{% endunless %}>
              <span data-tiers-label>{{ section.settings.button_label | default: 'Add to Cart' }}</span>
              <span class="vy-tiers__cta-arrow" aria-hidden="true">{%- render 'custom-icon', icon: 'arrow' -%}</span>
            </button>
          </form>
          <p class="vy-tiers__help" data-tiers-help aria-live="polite"></p>
        {%- elsif section.settings.button_label != blank -%}
          <a class="button button--primary vy-cta vy-tiers__cta" href="{{ section.settings.cta_link | default: '#' }}">
            {{ section.settings.button_label }}
            <span class="vy-tiers__cta-arrow" aria-hidden="true">{%- render 'custom-icon', icon: 'arrow' -%}</span>
          </a>
        {%- endif -%}
      </div>
    {%- elsif section.settings.heading != blank -%}
      <h2 class="vy-h2 vy-tiers__heading" style="text-align: {{ section.settings.heading_alignment }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- comment -%} On a product page, tiers with no product of their own fall back to the current product. {%- endcomment -%}
    {%- assign vy_page_product = product -%}
    <div class="vy-tiers__grid" style="--tier-cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product | default: vy_page_product
          assign qty = block.settings.quantity | at_least: 1
          assign variant = product.selected_or_first_available_variant
          assign unit_price = variant.price | default: product.price
          assign base_total = unit_price | times: qty
          assign discount = block.settings.discount_percent | default: 0

          if discount > 0
            assign keep = 100 | minus: discount
            assign pay_total = base_total | times: keep | divided_by: 100
            assign orig_total = base_total
            assign save_pct = discount
          else
            assign compare = variant.compare_at_price | default: product.compare_at_price
            assign pay_total = base_total
            assign orig_total = compare | times: qty
            assign save_pct = 0
            if orig_total > pay_total
              assign save_pct = orig_total | minus: pay_total | times: 100 | divided_by: orig_total
            endif
          endif

          assign per_unit = pay_total | divided_by: qty
        -%}
        <div class="vy-tiers__card vy-card {% if block.settings.highlight %}is-highlight{% endif %}{% if vy_buyable %} vy-tiers__card--select{% if forloop.index0 == vy_def_bidx %} is-selected{% endif %}{% endif %}"
          {%- if vy_buyable %} role="radio" aria-checked="{% if forloop.index0 == vy_def_bidx %}true{% else %}false{% endif %}" tabindex="{% if forloop.index0 == vy_def_bidx %}0{% else %}-1{% endif %}" data-tiers-tile data-variant-id="{{ variant.id }}" data-qty="{{ qty }}" data-discount="{{ discount }}" data-total="{% if block.settings.price_text != blank %}{{ block.settings.price_text | escape }}{% else %}{{ pay_total | money }}{% endif %}" data-available="{{ variant.available }}" data-label="{{ block.settings.label | default: product.title | escape }}" data-save="{{ block.settings.save_text | escape }}" data-page-product="{% if block.settings.product == blank %}true{% else %}false{% endif %}"{% endif -%}
          {{ block.shopify_attributes }}>
          {%- if vy_buyable -%}<span class="vy-tiers__check" aria-hidden="true">{%- render 'custom-icon', icon: 'checkmark' -%}</span>{%- endif -%}
          {%- unless tiers_split -%}
            {%- if block.settings.badge != blank -%}
              <span class="vy-tiers__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
          {%- endunless -%}

          {%- if tiers_split -%}
            <div class="vy-tiers__head">
              <span class="vy-tiers__num" aria-hidden="true">{{ forloop.index }}</span>
              <span class="vy-tiers__head-main">
                <h3 class="vy-tiers__label">{{ block.settings.label | default: product.title }}</h3>
                {%- if block.settings.badge != blank -%}
                  <span class="vy-tiers__badge vy-tiers__badge--inline">{{ block.settings.badge }}</span>
                {%- endif -%}
              </span>
            </div>
            <div class="vy-tiers__media vy-tiers__media--stack">
              {%- if block.settings.image_url != blank -%}
                <img class="vy-tiers__img" src="{{ block.settings.image_url }}" width="300" height="240" loading="lazy" alt="{{ block.settings.label | escape }}">
                {%- if block.settings.image_url2 != blank -%}
                  <img class="vy-tiers__img vy-tiers__img--2" src="{{ block.settings.image_url2 }}" width="300" height="240" loading="lazy" alt="">
                {%- endif -%}
                {%- if block.settings.image_url3 != blank -%}
                  <img class="vy-tiers__img vy-tiers__img--3" src="{{ block.settings.image_url3 }}" width="300" height="240" loading="lazy" alt="">
                {%- endif -%}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'vy-tiers__img', alt: block.settings.label }}
              {%- elsif product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'vy-tiers__img', alt: product.title }}
              {%- endif -%}
            </div>
            <div class="vy-tiers__price">
              <span class="vy-tiers__price-now">
                {%- if block.settings.price_text != blank -%}{{ block.settings.price_text }}{%- else -%}{{ pay_total | money }}{%- endif -%}
              </span>
              {%- if block.settings.price_text == blank and discount > 0 and orig_total > pay_total -%}
                <s class="vy-tiers__price-was">{{ orig_total | money }}</s>
              {%- endif -%}
            </div>
            {%- if block.settings.save_text != blank -%}
              <span class="vy-tiers__save {% if block.settings.save_text contains 'Save' or block.settings.save_text contains 'save' %}is-save{% endif %}">{{ block.settings.save_text }}</span>
            {%- elsif discount > 0 -%}
              {%- assign save_amt = orig_total | minus: pay_total -%}
              <span class="vy-tiers__save is-save">Save {{ save_amt | money }} ({{ discount }}%)</span>
            {%- endif -%}
          {%- else -%}
          <div class="vy-tiers__card-top">
            <a href="{{ product.url | default: '#' }}" class="vy-tiers__media" aria-label="{{ product.title | default: block.settings.label }}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'vy-tiers__img', alt: block.settings.label }}
              {%- elsif product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'vy-tiers__img', alt: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'vy-tiers__img placeholder-svg' }}
              {%- endif -%}
            </a>

            <div class="vy-tiers__info">
              <h3 class="vy-tiers__label">
                <a href="{{ product.url | default: '#' }}" class="vy-tiers__label-link">{{ block.settings.label | default: product.title }}</a>
              </h3>

              <div class="vy-tiers__price">
                <span class="vy-tiers__price-now">{{ pay_total | money }}</span>
                {%- if orig_total > pay_total -%}
                  <s class="vy-tiers__price-was">{{ orig_total | money }}</s>
                {%- endif -%}
              </div>

              {%- if qty > 1 -%}
                <span class="vy-tiers__unit">{{ per_unit | money }} each</span>
              {%- endif -%}

              {%- if save_pct > 0 -%}
                <span class="vy-tiers__save">Save {{ save_pct }}%</span>
              {%- endif -%}
            </div>
          </div>
          {%- endif -%}

          {%- if tiers_split -%}
          {%- elsif product != blank and variant != blank -%}
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="vy-tiers__form" data-ajax-cart>
              <input type="hidden" name="id" value="{{ variant.id }}">
              <input type="hidden" name="quantity" value="{{ qty }}">
              <button
                type="submit"
                name="add"
                class="button vy-cta {% if block.settings.highlight %}button--primary{% else %}button--secondary{% endif %}"
                {% unless variant.available %}disabled{% endunless %}
              >
                {%- if variant.available -%}
                  {{ section.settings.button_label }}
                {%- else -%}
                  Sold out
                {%- endif -%}
              </button>
            </form>
          {%- else -%}
            <p class="vy-tiers__empty">Chọn product cho tier này.</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if vy_buyable and section.settings.enable_mix -%}
      {%- assign vy_mix_product = section.blocks.first.settings.product | default: vy_page_product -%}
      {%- if vy_mix_product != blank and vy_mix_product.variants.size > 1 -%}
        <script type="application/json" data-tiers-variants>[{%- for v in vy_mix_product.variants -%}{%- unless forloop.first -%},{%- endunless -%}{"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"available":{{ v.available }}}{%- endfor -%}]</script>
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="vy-tiers__mixform" data-ajax-cart data-tiers-mixform hidden></form>
        <div class="vy-tiers__modal" data-tiers-modal hidden>
          <div class="vy-tiers__modal-backdrop" data-tiers-close></div>
          <div class="vy-tiers__modal-box" role="dialog" aria-modal="true" aria-label="Choose your pairs">
            <button type="button" class="vy-tiers__modal-x" data-tiers-close aria-label="Close">{%- render 'custom-icon', icon: 'close' -%}</button>
            <h3 class="vy-tiers__modal-title">Choose your <span data-mix-count>2</span> pairs</h3>
            <p class="vy-tiers__modal-sub">Mix colours and sizes — your bundle discount applies automatically at checkout.</p>
            <div class="vy-tiers__modal-slots" data-mix-slots></div>
            <p class="vy-tiers__modal-total" data-mix-total></p>
            <button type="button" class="button button--primary vy-cta vy-tiers__modal-add" data-mix-add>Add bundle to cart</button>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{%- if vy_buyable -%}
<script>
(function(){
  var root=document.getElementById('vy-tiers-{{ section.id }}');
  if(!root)return;
  var form=root.querySelector('[data-tiers-form]');
  if(!form)return;
  var idIn=form.querySelector('[data-tiers-id]'),qtyIn=form.querySelector('[data-tiers-qty]'),
      lbl=form.querySelector('[data-tiers-label]'),addBtn=form.querySelector('[data-tiers-add]'),
      help=root.querySelector('[data-tiers-help]'),
      tiles=[].slice.call(root.querySelectorAll('[data-tiers-tile]')),cur=0;
  if(!tiles.length)return;
  tiles.forEach(function(t,i){ if(t.getAttribute('aria-checked')==='true')cur=i; });
  function pageVariantId(){
    var el=document.querySelector('form[data-type="add-to-cart-form"] [name="id"], product-form form [name="id"]');
    return el&&el.value?el.value:null;
  }
  function resolveId(t){
    if(t.getAttribute('data-page-product')==='true'){ var v=pageVariantId(); if(v)return v; }
    return t.getAttribute('data-variant-id');
  }
  function select(i){
    cur=i;
    tiles.forEach(function(t,j){
      var on=j===i;
      t.classList.toggle('is-selected',on);
      t.setAttribute('aria-checked',on?'true':'false');
      t.setAttribute('tabindex',on?'0':'-1');
    });
    var t=tiles[i]; if(!t)return;
    if(idIn)idIn.value=resolveId(t);
    if(qtyIn)qtyIn.value=t.getAttribute('data-qty')||'1';
    if(lbl)lbl.textContent='Add '+(t.getAttribute('data-label')||'')+' · '+(t.getAttribute('data-total')||'');
    if(addBtn)addBtn.disabled=(t.getAttribute('data-available')!=='true');
    if(help){ var s=t.getAttribute('data-save'); help.textContent=s?((t.getAttribute('data-label')||'')+' · '+s):''; }
  }
  tiles.forEach(function(t,i){
    t.addEventListener('click',function(){ select(i); t.focus(); });
    t.addEventListener('keydown',function(e){
      if(e.key==='Enter'||e.key===' '){ e.preventDefault(); select(i); }
      else if(e.key==='ArrowRight'||e.key==='ArrowDown'){ e.preventDefault(); var n=(i+1)%tiles.length; tiles[n].focus(); select(n); }
      else if(e.key==='ArrowLeft'||e.key==='ArrowUp'){ e.preventDefault(); var p=(i+tiles.length-1)%tiles.length; tiles[p].focus(); select(p); }
    });
  });
  var mainForm=document.querySelector('form[data-type="add-to-cart-form"]');
  if(mainForm)mainForm.addEventListener('change',function(){ if(tiles[cur]&&tiles[cur].getAttribute('data-page-product')==='true'&&idIn)idIn.value=resolveId(tiles[cur]); });

  var CUR='{{ cart.currency.iso_code | default: shop.currency }}';
  function money(cents){ try{ return new Intl.NumberFormat(undefined,{style:'currency',currency:CUR}).format(cents/100); }catch(e){ return '$'+(cents/100).toFixed(2); } }
  var vjson=root.querySelector('[data-tiers-variants]'),variants=[];
  if(vjson){ try{ variants=JSON.parse(vjson.textContent)||[]; }catch(e){} }
  var modal=root.querySelector('[data-tiers-modal]'),
      mixform=root.querySelector('[data-tiers-mixform]'),
      slotsEl=modal&&modal.querySelector('[data-mix-slots]'),
      totalEl=modal&&modal.querySelector('[data-mix-total]'),
      countEl=modal&&modal.querySelector('[data-mix-count]'),
      mixAdd=modal&&modal.querySelector('[data-mix-add]'),
      lastFocus=null;
  var mixEnabled=!!(modal&&mixform&&variants.length>1);
  function availVariants(){ return variants.filter(function(v){return v.available;}); }
  function findVar(id){ for(var i=0;i<variants.length;i++){ if(String(variants[i].id)===String(id))return variants[i]; } return null; }
  function optionsHtml(sel){ return availVariants().map(function(v){ return '<option value="'+v.id+'"'+(String(v.id)===String(sel)?' selected':'')+'>'+String(v.title||'').replace(/</g,'&lt;')+'</option>'; }).join(''); }
  function recalcTotal(disc){
    if(!totalEl)return;
    var sum=0; [].forEach.call(slotsEl.querySelectorAll('select'),function(s){ var v=findVar(s.value); if(v)sum+=v.price; });
    var pay=Math.round(sum*(100-disc)/100),html='Total: '+money(pay);
    if(disc>0&&sum>pay){ html+=' <span class="vy-tiers__modal-save">· Save '+money(sum-pay)+' ('+disc+'%)</span>'; }
    totalEl.innerHTML=html;
  }
  function closeMix(){ if(modal){ modal.hidden=true; if(lastFocus&&lastFocus.focus)lastFocus.focus(); } }
  function openMix(qty,disc,defId){
    if(!mixEnabled)return false;
    if(countEl)countEl.textContent=qty;
    var opts=optionsHtml(defId),rows='';
    for(var i=0;i<qty;i++){ rows+='<div class="vy-tiers__slot"><span class="vy-tiers__slot-n" aria-hidden="true">'+(i+1)+'</span><label style="flex:1"><span class="visually-hidden">Pair '+(i+1)+'</span><select>'+opts+'</select></label></div>'; }
    slotsEl.innerHTML=rows;
    [].forEach.call(slotsEl.querySelectorAll('select'),function(s){ s.addEventListener('change',function(){recalcTotal(disc);}); });
    mixAdd.onclick=function(){
      var items=[].map.call(slotsEl.querySelectorAll('select'),function(s){return s.value;}).filter(Boolean);
      if(!items.length)return;
      mixform.innerHTML=items.map(function(id,k){return '<input type="hidden" name="items['+k+'][id]" value="'+id+'"><input type="hidden" name="items['+k+'][quantity]" value="1">';}).join('');
      closeMix();
      if(mixform.requestSubmit)mixform.requestSubmit(); else mixform.submit();
    };
    recalcTotal(disc);
    lastFocus=document.activeElement; modal.hidden=false;
    var f=slotsEl.querySelector('select'); if(f)f.focus();
    return true;
  }
  if(modal){
    [].forEach.call(modal.querySelectorAll('[data-tiers-close]'),function(el){ el.addEventListener('click',closeMix); });
    document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&!modal.hidden)closeMix(); });
  }
  form.addEventListener('submit',function(e){
    var t=tiles[cur]; if(!t)return;
    var q=parseInt(t.getAttribute('data-qty')||'1',10),disc=parseInt(t.getAttribute('data-discount')||'0',10);
    if(mixEnabled&&q>1){ e.preventDefault(); e.stopImmediatePropagation(); openMix(q,disc,resolveId(t)); return; }
    if(idIn)idIn.value=resolveId(t);
  },true);
  select(cur);
})();
</script>
{%- endif -%}

{%- else -%}{%- if request.design_mode -%}<div class="vy-hidden-note" style="padding:1.2rem 1.6rem;margin:0.4rem auto;max-width:60rem;border:0.1rem dashed rgba(128,128,128,0.55);border-radius:0.6rem;font-size:1.3rem;text-align:center;opacity:0.85;">Hidden on the current Store type (<b>{{ settings.store_type | default: 'v1' | upcase }}</b>). Shows on: <b>{{ section.settings.type_visibility | default: 'all' | upcase }}</b>. Change “Store type” in Theme settings, or this section’s “Show on store type”.</div>{%- endif -%}{%- endunless -%}

{% stylesheet %}
  .vy-tiers__heading {
    margin: 0 0 2.8rem;
  }

  .vy-tiers__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  .vy-tiers__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    text-align: left;
    padding: 2.4rem 1.8rem 1.8rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    background: rgb(var(--color-background));
    border-radius: var(--vy-card-radius, 0);
    overflow: visible; /* let the "MOST POPULAR" badge sit above the card */
  }

  .vy-tiers__card.is-highlight {
    border-color: rgb(var(--color-accent-strong, var(--color-button)));
    border-width: 0.2rem;
  }

  .vy-tiers__card-top {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .vy-tiers__info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .vy-tiers__badge {
    position: absolute;
    top: -1.1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .vy-tiers__media {
    display: block;
    width: 8.5rem;
    flex: 0 0 8.5rem;
    aspect-ratio: 1 / 1;
    overflow: hidden; /* card is overflow:visible now — clip the image here instead */
    border-radius: 0.8rem;
  }

  .vy-tiers__label-link {
    color: inherit;
    text-decoration: none;
  }

  .vy-tiers__label-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .vy-tiers__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 0.8rem;
  }

  .vy-tiers__label {
    margin: 0;
    font-size: 1.7rem;
  }

  .vy-tiers__price {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .vy-tiers__price-now {
    font-size: 2.4rem;
    font-weight: 700;
  }

  .vy-tiers__price-was {
    opacity: 0.72;
  }

  .vy-tiers__unit {
    font-size: 1.2rem;
    opacity: 0.9;
  }

  .vy-tiers__save {
    color: rgb(var(--color-button-text));
    background: rgb(var(--color-button));
    font-weight: 700;
    font-size: 1.2rem;
    padding: 0.3rem 1rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .vy-tiers__form {
    width: 100%;
    margin-top: auto; /* push CTA to the bottom so every tier's button lines up */
    padding-top: 0.8rem;
  }

  .vy-tiers__form .vy-cta {
    width: 100%;
  }

  /* Split layout: left intro + single CTA, right tier tiles (matches Barevance design) */
  .vy-tiers--split.vy-section {
    background: rgb(var(--brand-sand, 246, 241, 231));
  }
  .vy-tiers__intro { margin-bottom: 2.4rem; }
  .vy-tiers--split .vy-tiers__heading { margin: 0 0 1rem; text-wrap: balance; font-size: calc(3.2rem * var(--font-heading-scale, 1)); line-height: 1.15; }
  .vy-tiers__cta-arrow { display: inline-flex; margin-left: 0.6rem; }
  .vy-tiers__cta-arrow .svg-wrapper,
  .vy-tiers__cta-arrow svg { width: 1.5rem; height: 1.5rem; }
  .vy-tiers__sub { margin: 0 0 1.8rem; font-size: 1.5rem; opacity: 0.82; max-width: 34rem; }
  .vy-tiers__cta { display: inline-flex; }

  @media screen and (min-width: 750px) {
    .vy-tiers__grid {
      grid-template-columns: repeat(var(--tier-cols, 3), 1fr);
      align-items: stretch; /* equal-height cards so CTAs align */
    }

    .vy-tiers__card.is-highlight {
      box-shadow: 0 1.2rem 3.2rem rgba(0, 0, 0, 0.14);
    }
  }

  @media screen and (min-width: 990px) {
    .vy-tiers--split .vy-container {
      display: grid;
      grid-template-columns: 1.1fr 1.8fr;
      gap: 3.2rem;
      align-items: center;
    }
    .vy-tiers--split .vy-tiers__intro { margin-bottom: 0; }
  }

  /* Split promo tiles — design parity (white card, grey image box, green price,
     plain-text savings, green Best Value badge). */
  .vy-tiers--split .vy-tiers__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    background: rgb(var(--brand-bg, 255, 255, 255));
    border: 0.1rem solid rgba(var(--color-foreground), 0.06);
    border-radius: 1.4rem;
    padding: 1.8rem 1.6rem;
    box-shadow: 0 0.8rem 2rem rgba(0, 0, 0, 0.06);
  }

  .vy-tiers--split .vy-tiers__media {
    background: rgba(var(--color-foreground), 0.04);
  }

  .vy-tiers--split .vy-tiers__head {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 2rem;
  }

  .vy-tiers--split .vy-tiers__num {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 1.3rem;
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.4);
  }

  .vy-tiers--split .vy-tiers__label {
    font-size: 1.6rem;
    font-weight: 700;
  }

  .vy-tiers--split .vy-tiers__media {
    width: 100%;
    flex: none;
    aspect-ratio: 16 / 10;
    background: rgba(var(--color-foreground), 0.05);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .vy-tiers--split .vy-tiers__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1rem;
  }

  .vy-tiers--split .vy-tiers__price {
    justify-content: center;
  }

  .vy-tiers--split .vy-tiers__price-now {
    color: rgb(var(--brand-primary, 35, 69, 45));
    font-size: 2.2rem;
    font-weight: 800;
  }

  .vy-tiers--split .vy-tiers__save {
    background: transparent;
    color: rgba(var(--color-foreground), 0.65);
    padding: 0;
    border-radius: 0;
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: 0;
  }

  .vy-tiers--split .vy-tiers__save.is-save {
    color: rgb(var(--brand-primary, 35, 69, 45));
    font-weight: 600;
  }

  .vy-tiers--split .vy-tiers__head-main {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .vy-tiers__badge--inline {
    position: static;
    transform: none;
    background: rgb(var(--brand-primary, 35, 69, 45));
    color: #fff;
    text-transform: none;
    letter-spacing: 0;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.3rem 0.9rem;
  }
  /* Buyable split: selectable tiles + single Add-to-Cart */
  .vy-tiers--buyable .vy-tiers__card--select { cursor: pointer; position: relative; }
  .vy-tiers--split .vy-tiers__card--select { border: 0.2rem solid rgba(var(--color-foreground), 0.06); transition: border-color .15s, box-shadow .15s, transform .08s; }
  .vy-tiers--split .vy-tiers__card--select:hover { box-shadow: 0 1.2rem 2.6rem rgba(0, 0, 0, .1); }
  .vy-tiers--split .vy-tiers__card--select:active { transform: scale(.995); }
  .vy-tiers--split .vy-tiers__card--select.is-selected { border-color: rgb(var(--brand-primary, 35, 69, 45)); box-shadow: 0 1.4rem 3rem rgba(35, 69, 45, .18); }
  .vy-tiers__card--select:focus-visible { outline: 0.3rem solid rgba(var(--brand-primary, 35, 69, 45), .35); outline-offset: 0.2rem; }
  .vy-tiers__check { position: absolute; top: 1rem; right: 1rem; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: rgb(var(--brand-primary, 35, 69, 45)); color: #fff; display: none; align-items: center; justify-content: center; z-index: 2; }
  .vy-tiers__check .svg-wrapper, .vy-tiers__check svg { width: 1.3rem; height: 1.3rem; }
  .vy-tiers__card--select.is-selected .vy-tiers__check { display: inline-flex; }
  .vy-tiers__buyform { margin: 0; }
  .vy-tiers__help { margin: 1rem 0.2rem 0; font-size: 1.3rem; font-weight: 600; color: rgb(var(--brand-primary, 35, 69, 45)); min-height: 1.2rem; }
  .vy-tiers__cta[disabled] { opacity: .5; cursor: not-allowed; }
  .vy-tiers--split .vy-tiers__price { gap: 0.8rem; flex-wrap: wrap; }
  .vy-tiers--split .vy-tiers__price-was { text-decoration: line-through; font-size: 1.5rem; font-weight: 600; color: rgba(var(--color-foreground), 0.5); opacity: 1; }
  /* Mix-and-match modal */
  .vy-tiers__modal { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 1.6rem; }
  .vy-tiers__modal[hidden] { display: none; }
  .vy-tiers__modal-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, .5); }
  .vy-tiers__modal-box { position: relative; background: rgb(var(--color-background)); border-radius: 1.4rem; max-width: 46rem; width: 100%; max-height: 85vh; overflow-y: auto; padding: 2.6rem 2rem 2rem; box-shadow: 0 2rem 5rem rgba(0, 0, 0, .3); }
  .vy-tiers__modal-x { position: absolute; top: 1.1rem; right: 1.1rem; background: none; border: 0; cursor: pointer; padding: .5rem; line-height: 0; color: inherit; }
  .vy-tiers__modal-x .svg-wrapper, .vy-tiers__modal-x svg { width: 1.6rem; height: 1.6rem; }
  .vy-tiers__modal-title { margin: 0 0 .4rem; font-size: 1.9rem; }
  .vy-tiers__modal-sub { margin: 0 0 1.6rem; font-size: 1.3rem; opacity: .75; }
  .vy-tiers__modal-slots { display: grid; gap: 1rem; margin-bottom: 1.4rem; }
  .vy-tiers__slot { display: flex; align-items: center; gap: 1rem; }
  .vy-tiers__slot-n { flex: 0 0 auto; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: rgba(var(--color-foreground), .07); display: inline-flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 600; }
  .vy-tiers__slot select { flex: 1; width: 100%; min-height: 4.4rem; }
  .vy-tiers__modal-total { font-size: 1.6rem; font-weight: 700; margin: 0 0 1.2rem; text-align: center; }
  .vy-tiers__modal-total .vy-tiers__modal-save { color: rgb(var(--brand-primary, 35, 69, 45)); }
  .vy-tiers__modal-add { width: 100%; }
{% endstylesheet %}
{% schema %}
{
  "name": "Pricing tiers",
  "tag": "section",
  "class": "vy-tiers-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All layouts" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid (nút mỗi tier)" },
        { "value": "split", "label": "Split (intro trái + tiles phải)" }
      ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "split_buyable", "label": "Split: cho phép chọn & Add to Cart", "default": true },
    { "type": "checkbox", "id": "enable_mix", "label": "Split: mix màu/size khi mua nhiều đôi (modal)", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose Your Set" },
    { "type": "textarea", "id": "subheading", "label": "Subheading (split)", "default": "Mix colors and styles for your lifestyle." },
    { "type": "url", "id": "cta_link", "label": "CTA link (split)" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "button_label", "label": "Nút", "default": "Add to Cart" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "quantity", "label": "Số lượng thêm vào giỏ", "min": 1, "max": 10, "step": 1, "default": 1 },
        {
          "type": "range",
          "id": "discount_percent",
          "label": "Giảm giá tier này (%)",
          "info": "Display only — must match an Automatic discount in Admin → Discounts (e.g. buy 2 → 10%), or checkout won't apply it. Run bootstrap-store.mjs with BOOTSTRAP_QTY_DISCOUNTS=1 to create the matching buy-2/3/4 discounts. 0 = use the product's compare-at price instead.",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        { "type": "text", "id": "label", "label": "Nhãn tier", "default": "1 × Product" },
        { "type": "text", "id": "badge", "label": "Badge (vd MOST POPULAR)" },
        { "type": "checkbox", "id": "highlight", "label": "Nổi bật tier này", "default": false },
        { "type": "image_picker", "id": "image", "label": "Ảnh riêng (tuỳ chọn)" },
        { "type": "header", "content": "Split layout (promo tiles)" },
        { "type": "text", "id": "price_text", "label": "Giá hiển thị (vd $79.99)" },
        { "type": "text", "id": "save_text", "label": "Dòng phụ (vd Standard / Save $19.99)" },
        { "type": "text", "id": "image_url", "label": "Ảnh 1 (URL CDN)" },
        { "type": "text", "id": "image_url2", "label": "Ảnh 2 (URL CDN)" },
        { "type": "text", "id": "image_url3", "label": "Ảnh 3 (URL CDN)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing tiers",
      "blocks": [
        { "type": "tier", "settings": { "quantity": 1, "label": "1 × Product", "discount_percent": 0 } },
        { "type": "tier", "settings": { "quantity": 2, "label": "2 × Product", "badge": "MOST POPULAR", "highlight": true, "discount_percent": 10 } },
        { "type": "tier", "settings": { "quantity": 3, "label": "3 × Product", "discount_percent": 15 } },
        { "type": "tier", "settings": { "quantity": 4, "label": "4 × Product", "discount_percent": 20 } }
      ]
    }
  ]
}
{% endschema %}
