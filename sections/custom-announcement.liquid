{%- comment -%}
  custom-announcement — Top bar with 2–3 static messages separated by dividers,
  matching the reference design (FREE SHIPPING | 30-DAY GUARANTEE | LOVED BY ...).
  Used in the header group. Mobile: shows the first message only (or scrolls).
{%- endcomment -%}

<announcement-bar class="custom-ann color-{{ section.settings.color_scheme }} gradient">
  <div class="custom-ann__inner">
    {%- for block in section.blocks -%}
      <span class="custom-ann__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}
          <span class="custom-ann__icon">{%- render 'custom-icon', icon: block.settings.icon -%}</span>
        {%- endif -%}
        <span class="custom-ann__text">{{ block.settings.text }}</span>
      </span>
    {%- endfor -%}
  </div>
  <script>
    (function () {
      class AnnouncementBar extends HTMLElement {
        connectedCallback() {
          this.items = Array.prototype.slice.call(this.querySelectorAll('.custom-ann__item'));
          if (this.items.length < 2) return;
          this.i = 0;
          this.mq = window.matchMedia('(max-width: 749px)');
          this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
          this.update = this.update.bind(this);
          this.update();
          this.mq.addEventListener('change', this.update);
          this.reduce.addEventListener('change', this.update);
        }
        update() {
          var rotate = this.mq.matches && !this.reduce.matches;
          if (rotate) {
            this.classList.add('is-rotating');
            this.show(this.i);
            if (!this.timer) {
              this.timer = setInterval(() => {
                this.i = (this.i + 1) % this.items.length;
                this.show(this.i);
              }, 3500);
            }
          } else {
            this.classList.remove('is-rotating');
            if (this.timer) { clearInterval(this.timer); this.timer = null; }
            this.items.forEach((el) => el.removeAttribute('data-ann-active'));
          }
        }
        show(n) {
          this.items.forEach((el, idx) => el.toggleAttribute('data-ann-active', idx === n));
        }
        disconnectedCallback() { if (this.timer) clearInterval(this.timer); }
      }
      if (!customElements.get('announcement-bar')) {
        customElements.define('announcement-bar', AnnouncementBar);
      }
    })();
  </script>
</announcement-bar>

{% stylesheet %}
  .custom-ann {
    padding: 0.9rem 1.5rem;
  }

  .custom-ann__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    max-width: var(--page-width);
    margin-inline: auto;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .custom-ann__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    position: relative;
  }

  /* divider between items */
  .custom-ann__item + .custom-ann__item::before {
    content: '';
    position: absolute;
    left: -0.9rem;
    top: 50%;
    transform: translateY(-50%);
    width: 0.1rem;
    height: 1.3rem;
    background: rgba(var(--color-foreground), 0.3);
  }

  .custom-ann__icon {
    color: rgb(var(--color-foreground));
    display: inline-flex;
  }

  .custom-ann__icon .svg-wrapper {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Dawn icons default to black fill; force them to follow the bar's text color */
  .custom-ann__icon svg {
    fill: currentColor;
  }

  .custom-ann { display: block; }

  /* Mobile: no-JS / reduced-motion fallback shows every message, wrapped (nothing hidden). */
  @media screen and (max-width: 749px) {
    .custom-ann__inner {
      gap: 0.6rem 1.4rem;
      flex-wrap: wrap;
    }
    .custom-ann__item + .custom-ann__item::before {
      display: none;
    }

    /* With JS + motion allowed, rotate one message at a time (all still reachable). */
    .custom-ann.is-rotating .custom-ann__inner {
      flex-wrap: nowrap;
      position: relative;
      min-height: 1.8rem;
    }
    .custom-ann.is-rotating .custom-ann__item {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .custom-ann.is-rotating .custom-ann__item[data-ann-active] {
      position: relative;
      left: auto;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Announcement bar",
  "class": "custom-ann-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "check_mark", "label": "Check" },
            { "value": "paw_print", "label": "Paw" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on all orders over $40" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "icon": "truck", "text": "FREE SHIPPING on all orders over $40" } },
        { "type": "message", "settings": { "icon": "return", "text": "30-DAY MONEY BACK GUARANTEE" } },
        { "type": "message", "settings": { "icon": "heart", "text": "LOVED BY 10,000+ CUSTOMERS" } }
      ]
    }
  ]
}
{% endschema %}
