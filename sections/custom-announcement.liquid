{%- comment -%}
  custom-announcement — Top bar with 2–3 static messages separated by dividers,
  matching the reference design (FREE SHIPPING | 30-DAY GUARANTEE | LOVED BY ...).
  Used in the header group. Mobile: shows the first message only (or scrolls).
{%- endcomment -%}

<div class="custom-ann color-{{ section.settings.color_scheme }} gradient">
  <div class="custom-ann__inner">
    {%- for block in section.blocks -%}
      <span class="custom-ann__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}
          <span class="custom-ann__icon">{%- render 'custom-icon', icon: block.settings.icon -%}</span>
        {%- endif -%}
        <span class="custom-ann__text">{{ block.settings.text }}</span>
      </span>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .custom-ann {
    padding: 0.9rem 1.5rem;
  }

  .custom-ann__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    max-width: var(--page-width);
    margin-inline: auto;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .custom-ann__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    position: relative;
  }

  /* divider between items */
  .custom-ann__item + .custom-ann__item::before {
    content: '';
    position: absolute;
    left: -0.9rem;
    top: 50%;
    transform: translateY(-50%);
    width: 0.1rem;
    height: 1.3rem;
    background: rgba(var(--color-foreground), 0.3);
  }

  .custom-ann__icon {
    color: rgb(var(--color-foreground));
    display: inline-flex;
  }

  .custom-ann__icon .svg-wrapper {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Dawn icons default to black fill; force them to follow the bar's text color */
  .custom-ann__icon svg {
    fill: currentColor;
  }

  /* Mobile: keep only the first item to avoid crowding */
  @media screen and (max-width: 749px) {
    .custom-ann__inner {
      gap: 0;
    }
    .custom-ann__item + .custom-ann__item {
      display: none;
    }
    .custom-ann__item + .custom-ann__item::before {
      display: none;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Announcement bar",
  "class": "custom-ann-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "check_mark", "label": "Check" },
            { "value": "paw_print", "label": "Paw" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on all orders over $40" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "icon": "truck", "text": "FREE SHIPPING on all orders over $40" } },
        { "type": "message", "settings": { "icon": "return", "text": "30-DAY MONEY BACK GUARANTEE" } },
        { "type": "message", "settings": { "icon": "heart", "text": "LOVED BY 10,000+ CUSTOMERS" } }
      ]
    }
  ]
}
{% endschema %}
