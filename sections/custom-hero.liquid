{%- comment -%}
  vy-hero — Shared hero section (mobile-first) used by One Product / Multi Style /
  Multi Product templates and PDP. Media + content two-column on desktop, stacked on mobile.
  Colors/fonts come from the color scheme + global design tokens (never hard-coded).
{%- endcomment -%}

{%- comment -%} Preload the hero image (LCP element) responsively so it isn't discovered only when the section HTML is parsed. {%- endcomment -%}
{%- if section.settings.image != blank -%}
  {% comment %}theme-check-disable AssetPreload{% endcomment %}
  {%- if section.settings.mobile_image != blank -%}
    <link rel="preload" as="image" media="(max-width: 749px)" imagesrcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w" imagesizes="100vw">
    <link rel="preload" as="image" media="(min-width: 750px)" imagesrcset="{{ section.settings.image | image_url: width: 660 }} 660w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 1600 }} 1600w" imagesizes="(min-width: 990px) 50vw, 100vw">
  {%- else -%}
    <link rel="preload" as="image" imagesrcset="{{ section.settings.image | image_url: width: 660 }} 660w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 1600 }} 1600w" imagesizes="(min-width: 990px) 50vw, 100vw">
  {%- endif -%}
  {% comment %}theme-check-enable AssetPreload{% endcomment %}
{%- endif -%}

{%- liquid
  assign media_placement = section.settings.desktop_media_placement
  assign mobile_pos = section.settings.mobile_media_position
  assign align = section.settings.content_alignment
  if align == 'center'
    assign align_items = 'center'
  else
    assign align_items = 'flex-start'
  endif
  # On the home page the logo is the h1 (Dawn), so the hero heading is an h2 to avoid two h1s.
  assign hero_tag = 'h1'
  if template.name == 'index'
    assign hero_tag = 'h2'
  endif
-%}

<div
  class="vy-hero color-{{ section.settings.color_scheme }} gradient vy-section vy-hero--h-{{ section.settings.section_height }}"
  style="--hero-align: {{ align }}; --hero-align-items: {{ align_items }};"
>
  <div class="vy-container vy-hero__inner media-{{ media_placement }} mobile-{{ mobile_pos }}{% if section.settings.media_style == 'fullbleed' %} vy-hero--fullbleed{% endif %}{% if section.settings.media_style == 'overlay' %} vy-hero--overlay{% endif %}">
    <div class="vy-hero__media{% if section.settings.media_style == 'boxed' %} vy-card{% endif %}">
      {%- if section.settings.media_style == 'overlay' -%}
        <span class="vy-hero__scrim"></span>
      {%- endif -%}
      {%- if section.settings.media_caption != blank -%}
        <span class="vy-hero__media-caption">{{ section.settings.media_caption }}</span>
      {%- endif -%}
      {%- if section.settings.image_url != blank -%}
        <img class="vy-hero__image" src="{{ section.settings.image_url }}" width="1600" height="1200" loading="eager" fetchpriority="high" alt="{{ section.settings.heading | escape }}">
      {%- elsif section.settings.image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w"
            >
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 990px) 50vw, 100vw',
              widths: '450, 660, 900, 1100, 1400, 1600',
              class: 'vy-hero__image',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'vy-hero__image placeholder-svg' }}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <div class="vy-hero__badge" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <span class="vy-hero__badge-title">{{ block.settings.title }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="vy-hero__badge-text">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="vy-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vy-eyebrow vy-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ hero_tag }} class="vy-h1 vy-hero__heading">
          {{ section.settings.heading }}
          {%- if section.settings.heading_highlight != blank -%}
            <span class="vy-hero__heading-accent">{{ section.settings.heading_highlight }}</span>
          {%- endif -%}
        </{{ hero_tag }}>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="vy-hero__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
      {%- if feature_blocks.size > 0 -%}
        <ul class="vy-hero__features" role="list">
          {%- for block in feature_blocks -%}
            <li class="vy-hero__feature" {{ block.shopify_attributes }}>
              <span class="vy-hero__feature-icon">
                {%- render 'custom-icon', icon: block.settings.icon -%}
              </span>
              {%- if block.settings.text != blank -%}
                <span class="vy-hero__feature-text">{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- assign rating_blocks = section.blocks | where: 'type', 'rating' -%}
      {%- for block in rating_blocks -%}
        <div class="vy-hero__rating" {{ block.shopify_attributes }}>
          {%- if block.settings.avatars != blank -%}
            {{
              block.settings.avatars
              | image_url: width: 240
              | image_tag: loading: 'lazy', class: 'vy-hero__avatars', alt: ''
            }}
          {%- endif -%}
          <span class="vy-hero__rating-body">
            {%- render 'custom-stars', rating: block.settings.stars -%}
            {%- if block.settings.text != blank -%}
              <span class="vy-hero__rating-text">{{ block.settings.text }}</span>
            {%- endif -%}
          </span>
        </div>
      {%- endfor -%}

      {%- assign button_blocks = section.blocks | where: 'type', 'button' -%}
      {%- if button_blocks.size > 0 -%}
        <div class="vy-hero__buttons">
          {%- for block in button_blocks -%}
            {%- if block.settings.label != blank -%}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="button vy-cta {% if block.settings.style == 'secondary' %}button--secondary{% else %}button--primary{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label -}}
                {%- if block.settings.style != 'secondary' and section.settings.media_style == 'overlay' -%}<span class="vy-hero__btn-arrow" aria-hidden="true">→</span>{%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.footnote != blank -%}
        <p class="vy-hero__footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .vy-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
    align-items: stretch;
  }

  /* Mobile media order */
  .vy-hero__inner.mobile-bottom {
    flex-direction: column-reverse;
  }

  .vy-hero__media {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .vy-hero__image,
  .vy-hero__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vy-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    text-align: var(--hero-align, left);
    align-items: var(--hero-align-items, flex-start);
  }

  .vy-hero__eyebrow {
    color: rgb(var(--color-accent-strong, var(--color-button)));
    margin: 0;
  }

  .vy-hero__heading {
    margin: 0;
  }

  .vy-hero__heading-accent {
    color: rgb(var(--color-accent-strong, var(--color-button)));
    display: inline;
  }

  .vy-hero__subheading {
    max-width: 52rem;
    opacity: 0.85;
  }

  .vy-hero__features {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem 2rem;
  }

  .vy-hero__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
    flex: 0 0 auto;
    min-width: 7rem;
    font-size: 1.3rem;
  }

  .vy-hero__feature .svg-wrapper {
    width: 2.6rem;
    height: 2.6rem;
  }

  .vy-hero__rating {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .vy-hero__avatars {
    height: 3.2rem;
    width: auto;
    border-radius: 999px;
  }

  .vy-hero__rating-body {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .vy-hero__rating-text {
    font-size: 1.3rem;
    opacity: 0.85;
  }

  .vy-hero__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    margin-top: 0.4rem;
  }

  .vy-hero__footnote {
    font-size: 1.3rem;
    opacity: 0.8;
    margin: 0;
  }

  /* Circular callout badge over media */
  .vy-hero__badge {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    width: 9.5rem;
    height: 9.5rem;
    border-radius: 999px;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
    gap: 0.3rem;
  }

  .vy-hero__badge-title {
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
  }

  .vy-hero__badge-text {
    font-size: 1rem;
    line-height: 1.2;
  }

  /* Section height modifiers (min-heights on desktop) */
  @media screen and (min-width: 750px) {
    .vy-hero__badge {
      width: 12rem;
      height: 12rem;
      top: 2rem;
      right: 2rem;
    }
  }

  @media screen and (min-width: 990px) {
    .vy-hero__inner {
      flex-direction: row;
      align-items: center;
      gap: 4rem;
    }

    .vy-hero__inner.media-left {
      flex-direction: row-reverse;
    }

    .vy-hero__media,
    .vy-hero__content {
      flex: 1 1 50%;
      min-width: 0;
    }

    .vy-hero__media {
      aspect-ratio: 1 / 1;
    }

    .vy-hero--h-large .vy-hero__media {
      aspect-ratio: 4 / 5;
    }

    .vy-hero--h-small .vy-hero__media {
      aspect-ratio: 3 / 2;
    }

    .vy-hero__buttons {
      flex-direction: row;
      flex-wrap: wrap;
    }

  }

  /* ---- Full-bleed split hero (edge-to-edge media) ---- */
  .vy-hero__media-caption {
    position: absolute;
    z-index: 2;
    right: 1.6rem;
    top: 2rem;
    max-width: 15rem;
    text-align: right;
    color: #fff;
    font-family: var(--font-accent-family, inherit);
    font-style: italic;
    font-weight: 600;
    font-size: 2.2rem;
    line-height: 1.15;
    text-shadow: 0 0.2rem 1.2rem rgba(0, 0, 0, 0.35);
  }

  @media screen and (min-width: 990px) {
    .vy-hero__inner.vy-hero--fullbleed {
      max-width: none;
      padding-inline: 0;
      gap: 0;
      align-items: stretch;
      min-height: 60rem;
    }

    .vy-hero--fullbleed .vy-hero__content {
      flex: 0 1 46%;
      justify-content: center;
      padding-block: 5rem;
      padding-left: max(2rem, calc((100vw - var(--page-width, 130rem)) / 2 + 5rem));
      padding-right: 4rem;
    }

    .vy-hero--fullbleed .vy-hero__media {
      flex: 1 1 54%;
      aspect-ratio: auto;
      align-self: stretch;
      border-radius: 0;
    }

    .vy-hero--fullbleed .vy-hero__media-caption {
      right: 3rem;
      top: 4rem;
      font-size: 3.2rem;
      max-width: 22rem;
    }

    /* Match design content order: eyebrow, H1, sub, buttons, features */
    .vy-hero--fullbleed .vy-hero__buttons { order: 4; }
    .vy-hero--fullbleed .vy-hero__features { order: 5; margin-top: 1.2rem; }
    .vy-hero--fullbleed .vy-hero__rating { order: 6; }
  }

  /* ---- Overlay hero: full-width background photo + text overlaid ---- */
  /* Butt the overlay hero against the header (no section gap) */
  .vy-hero:has(.vy-hero--overlay) {
    padding-block: 0;
  }

  .vy-hero__inner.vy-hero--overlay {
    position: relative;
    display: block;
    max-width: none;
    padding-inline: 0;
    min-height: 46rem;
  }

  .vy-hero--overlay .vy-hero__media {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    overflow: hidden;
    z-index: 0;
  }

  .vy-hero--overlay .vy-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vy-hero--overlay .vy-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(248, 246, 240, 0.1) 0%, rgba(248, 246, 240, 0.72) 52%, rgba(248, 246, 240, 0.95) 100%);
  }

  .vy-hero--overlay .vy-hero__content {
    position: relative;
    z-index: 2;
    justify-content: flex-end;
    min-height: 46rem;
    padding: 2.4rem 1.5rem 3rem;
  }

  /* Match design: dark eyebrow, dark bold icons + 2-line labels, darker sub, CTA arrow */
  .vy-hero--overlay .vy-hero__eyebrow {
    color: rgb(var(--color-foreground));
    font-weight: 700;
  }

  .vy-hero--overlay .vy-hero__subheading {
    opacity: 1;
    color: rgba(var(--color-foreground), 0.88);
  }

  .vy-hero--overlay .vy-hero__feature {
    max-width: 8.5rem;
    color: rgb(var(--color-foreground));
  }

  .vy-hero--overlay .vy-hero__feature-icon,
  .vy-hero--overlay .vy-hero__feature-icon .svg-wrapper,
  .vy-hero--overlay .vy-hero__feature-icon svg {
    color: rgb(var(--color-foreground));
  }

  .vy-hero--overlay .vy-hero__feature-text {
    color: rgb(var(--color-foreground));
    font-weight: 600;
    white-space: normal;
    line-height: 1.2;
  }

  .vy-hero__btn-arrow {
    margin-left: 0.7rem;
    font-weight: 400;
    display: inline-block;
  }

  @media screen and (min-width: 990px) {
    .vy-hero__inner.vy-hero--overlay {
      display: flex;
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      min-height: 62rem;
    }

    .vy-hero--overlay .vy-hero__scrim {
      background: linear-gradient(90deg, rgba(248, 246, 240, 0.94) 0%, rgba(248, 246, 240, 0.82) 30%, rgba(248, 246, 240, 0.32) 52%, rgba(248, 246, 240, 0) 70%);
    }

    .vy-hero--overlay .vy-hero__content {
      flex: 0 1 56rem;
      max-width: 56rem;
      min-height: 0;
      justify-content: center;
      padding-block: 6rem;
      padding-right: 4rem;
      padding-left: max(2rem, calc((100vw - var(--page-width, 130rem)) / 2 + 5rem));
    }

    .vy-hero--overlay .vy-hero__buttons { order: 4; }
    .vy-hero--overlay .vy-hero__features { order: 5; margin-top: 1.2rem; flex-wrap: nowrap; gap: 1rem 1.6rem; }
    .vy-hero--overlay .vy-hero__feature { min-width: 0; font-size: 1.2rem; }
    .vy-hero--overlay .vy-hero__rating { order: 6; }

    .vy-hero--overlay .vy-hero__media-caption {
      color: #1c2a1f;
      text-shadow: none;
      right: 4rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 3rem;
      max-width: 20rem;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "vy-hero-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)"
    },
    { "type": "text", "id": "image_url", "label": "Hoặc URL ảnh (CDN)", "info": "Ưu tiên hơn image picker. Dùng khi ảnh đã upload lên Files." },
    {
      "type": "select",
      "id": "media_style",
      "label": "Kiểu ảnh",
      "options": [
        { "value": "boxed", "label": "Bọc khung (bo góc)" },
        { "value": "fullbleed", "label": "Full-bleed (ảnh 1 bên, tràn mép)" },
        { "value": "overlay", "label": "Overlay (ảnh nền full, chữ đè lên)" }
      ],
      "default": "boxed"
    },
    { "type": "text", "id": "media_caption", "label": "Chữ viết tay trên ảnh (fullbleed)", "info": "VD: Move Naturally. Live Fully." },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image (mobile, optional)",
      "info": "Ảnh riêng cho mobile để tối ưu khung hình & dung lượng."
    },
    {
      "type": "select",
      "id": "desktop_media_placement",
      "label": "Vị trí ảnh (desktop)",
      "options": [
        { "value": "right", "label": "Bên phải" },
        { "value": "left", "label": "Bên trái" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "mobile_media_position",
      "label": "Vị trí ảnh (mobile)",
      "options": [
        { "value": "top", "label": "Trên nội dung" },
        { "value": "bottom", "label": "Dưới nội dung" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Chiều cao ảnh (desktop)",
      "options": [
        { "value": "small", "label": "Thấp" },
        { "value": "medium", "label": "Vừa" },
        { "value": "large", "label": "Cao" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (accent font)",
      "default": "Made for cats."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Cutest Way To Take Your Cat"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight",
      "info": "Phần này hiển thị theo màu nhấn của color scheme.",
      "default": "Everywhere."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>A cozy and breathable design that keeps your pet safe, comfy, and part of every adventure.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote (dưới nút)",
      "default": "🚚 Free shipping today!"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Căn nội dung",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature icon",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "lock", "label": "Lock" },
            { "value": "check_mark", "label": "Check" },
            { "value": "eye", "label": "Eye" },
            { "value": "paw_print", "label": "Paw" },
            { "value": "plane", "label": "Plane" },
            { "value": "star", "label": "Star" },
            { "value": "fire", "label": "Fire" },
            { "value": "truck", "label": "Truck" },
            { "value": "padlock", "label": "Padlock (secure)" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Lightweight & Easy to Carry"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Rating / social proof",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "avatars",
          "label": "Avatars (ảnh nhóm khách hàng)"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Số sao",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 5
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "4.9/5 from 10,000+ happy customers"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Kiểu nút",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary (outline)" }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Circular badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tiêu đề",
          "default": "PEEKABOO WINDOW"
        },
