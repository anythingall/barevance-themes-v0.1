{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when settings.store_type is not in this section's type_visibility. Falls back to showing everything if store_type is blank. {%- endcomment -%}
{%- liquid
  assign edu_hide = false
  assign edu_vis = section.settings.type_visibility | default: 'all'
  assign edu_st = settings.store_type | default: 'v1'
  assign edu_on = false
  if template.name == 'index'
    assign edu_on = true
  endif
  if template.name == 'product'
    assign edu_on = true
  endif
  if edu_on and edu_vis != 'all'
    unless edu_vis contains edu_st
      assign edu_hide = true
    endunless
  endif
-%}
{%- unless edu_hide -%}
{%- comment -%}
  vy-education-cards — "New to X?" education / guide cards (mobile-first).
  Card = optional image + title + text + link. Desktop: grid of N columns.
  Mobile: horizontal scroller. Colors/fonts from color scheme + tokens.
{%- endcomment -%}

{%- liquid
  assign edu_count = section.blocks.size
  assign edu_cols = section.settings.columns | at_most: edu_count | at_least: 1
-%}
<div class="vy-edu color-{{ section.settings.color_scheme }} gradient vy-section">
  <div class="vy-container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="vy-edu__head">
        <div class="vy-edu__headings" style="text-align: {{ section.settings.heading_alignment }};">
          {%- if section.settings.eyebrow != blank -%}
            <p class="vy-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="vy-h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="vy-edu__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
          <a class="vy-edu__viewall" href="{{ section.settings.link_url }}">
            {{ section.settings.link_label }}
            <span class="vy-edu__viewall-arrow">{%- render 'custom-icon', icon: 'arrow' -%}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="vy-edu__grid {% if section.settings.mobile_layout == 'carousel' %}vy-scroller vy-scroller--grid-on-desktop{% else %}vy-grid{% endif %} list-unstyled"
      role="list"
      {%- if section.settings.mobile_layout == 'carousel' %} tabindex="0" aria-label="{{ section.settings.heading | default: 'Guides' | escape }} (scroll to see more)"{% endif %}
      style="--vy-grid-cols-desktop: {{ edu_cols }}; --vy-grid-cols-tablet: {{ edu_cols | at_most: 2 }}; --vy-scroller-cols-desktop: {{ edu_cols }}; --vy-scroller-item: 78%;"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign edu_href = block.settings.link_url
          assign edu_tag = 'div'
          if edu_href != blank
            assign edu_tag = 'a'
          endif
        -%}
        <li class="vy-edu__item" {{ block.shopify_attributes }}>
          <{{ edu_tag }} class="vy-edu__card"{% if edu_href != blank %} href="{{ edu_href }}"{% endif %}>
            {%- if block.settings.image_url != blank -%}
              <span class="vy-edu__media">
                <img class="vy-edu__img" src="{{ block.settings.image_url }}" width="600" height="450" loading="lazy" alt="{{ block.settings.title | escape }}">
              </span>
            {%- elsif block.settings.image != blank -%}
              <span class="vy-edu__media">
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 600',
                    sizes: '(min-width: 750px) 30vw, 78vw',
                    class: 'vy-edu__img',
                    alt: block.settings.title | escape
                }}
              </span>
            {%- endif -%}
            <span class="vy-edu__body">
              {%- if block.settings.title != blank -%}
                <span class="vy-edu__title">{{ block.settings.title }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="vy-edu__text">{{ block.settings.text }}</span>
              {%- endif -%}
              {%- if block.settings.link_label != blank and edu_href != blank -%}
                <span class="vy-edu__cta">
                  {{ block.settings.link_label }}
                  <span class="vy-edu__cta-arrow" aria-hidden="true">{%- render 'custom-icon', icon: 'arrow' -%}</span>
                </span>
              {%- endif -%}
            </span>
          </{{ edu_tag }}>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- else -%}{%- if request.design_mode -%}<div class="vy-hidden-note" style="padding:1.2rem 1.6rem;margin:0.4rem auto;max-width:60rem;border:0.1rem dashed rgba(128,128,128,0.55);border-radius:0.6rem;font-size:1.3rem;text-align:center;opacity:0.85;">Hidden on the current Store type (<b>{{ settings.store_type | default: 'v1' | upcase }}</b>). Shows on: <b>{{ section.settings.type_visibility | default: 'all' | upcase }}</b>. Change “Store type” in Theme settings, or this section’s “Show on store type”.</div>{%- endif -%}{%- endunless -%}

{% stylesheet %}
  .vy-edu__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.4rem;
  }

  .vy-edu__headings {
    flex: 1 1 60%;
  }

  .vy-edu__headings .vy-eyebrow {
    margin: 0 0 0.6rem;
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  .vy-edu__headings .vy-h2 {
    margin: 0;
  }

  .vy-edu__sub {
    margin: 0.6rem 0 0;
    font-size: 1.5rem;
    opacity: 0.82;
  }

  .vy-edu__viewall {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: none;
    color: rgb(var(--color-accent-strong, var(--color-button)));
    white-space: nowrap;
  }

  .vy-edu__viewall-arrow .svg-wrapper,
  .vy-edu__viewall-arrow svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .vy-edu__grid {
    margin: 0;
    padding: 0;
  }

  .vy-edu__card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 1.4rem;
    height: 100%;
    padding: 1.2rem;
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--vy-card-radius, 1.2rem);
    text-decoration: none;
    color: rgb(var(--color-foreground));
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .vy-edu__media {
    flex: 0 0 34%;
    border-radius: calc(var(--vy-card-radius, 1.2rem) - 0.4rem);
    overflow: hidden;
  }

  .vy-edu__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vy-edu__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.4rem 0.2rem;
  }

  .vy-edu__title {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .vy-edu__text {
    font-size: 1.35rem;
    opacity: 0.8;
    line-height: 1.5;
  }

  .vy-edu__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.35rem;
    font-weight: 600;
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  .vy-edu__cta-arrow .svg-wrapper,
  .vy-edu__cta-arrow svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  @media (hover: hover) {
    a.vy-edu__card:hover {
      border-color: rgba(var(--color-button), 0.5);
      transform: translateY(-0.2rem);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Education cards",
  "tag": "section",
  "class": "vy-edu-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All layouts" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New to Barefoot Shoes?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Here's everything you need to know before making the switch." },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Căn tiêu đề",
      "options": [
        { "value": "left", "label": "Trái" },
        { "value": "center", "label": "Giữa" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "link_label", "label": "Link phụ (nhãn)", "info": "VD: View All Guides" },
    { "type": "url", "id": "link_url", "label": "Link phụ (URL)" },
    {
      "type": "range",
      "id": "columns",
      "label": "Số cột (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Layout mobile",
      "options": [
        { "value": "stack", "label": "Xếp dọc (1 cột)" },
        { "value": "carousel", "label": "Cuộn ngang" }
      ],
      "default": "stack"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Guide card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Ảnh" },
        { "type": "text", "id": "image_url", "label": "Ảnh (URL CDN, ưu tiên)" },
        { "type": "text", "id": "title", "label": "Tiêu đề", "default": "What Are Barefoot Shoes?" },
        { "type": "textarea", "id": "text", "label": "Mô tả", "default": "Learn the benefits and how they work." },
        { "type": "text", "id": "link_label", "label": "CTA (nhãn)", "default": "Learn More" },
        { "type": "url", "id": "link_url", "label": "CTA (URL)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Education cards",
      "blocks": [
        { "type": "card", "settings": { "title": "What Are Barefoot Shoes?", "text": "Learn the benefits and how they work.", "link_label": "Learn More" } },
        { "type": "card", "settings": { "title": "How Should Barefoot Shoes Fit?", "text": "Get the right size and fit for maximum comfort.", "link_label": "Size Guide" } },
        { "type": "card", "settings": { "title": "How to Transition", "text": "Tips for making the switch comfortably.", "link_label": "Learn More" } }
      ]
    }
  ]
}
{% endschema %}
