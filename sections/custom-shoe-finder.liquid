{%- comment -%} Base theme: store-type gate — on home/product pages, hide this section when settings.store_type is not in this section's type_visibility. Falls back to showing everything if store_type is blank. {%- endcomment -%}
{%- liquid
  assign sf_hide = false
  assign sf_vis = section.settings.type_visibility | default: 'all'
  assign sf_st = settings.store_type | default: 'v1'
  assign sf_on = false
  if template.name == 'index'
    assign sf_on = true
  endif
  if template.name == 'product'
    assign sf_on = true
  endif
  if sf_on and sf_vis != 'all'
    unless sf_vis contains sf_st
      assign sf_hide = true
    endunless
  endif
-%}
{%- unless sf_hide -%}
{%- comment -%}
  vy-shoe-finder — Guided "product finder" quiz (mobile-first, no dependencies).
  Multi-step: one question per step, Back/Next, progress bar. Each answer option can
  carry a destination URL; on finish the finder navigates to the last selected option's
  URL (falling back through earlier answers, then the section default). Fully config-
  driven — no hard-coded routing. Colors/fonts from color scheme + tokens.
{%- endcomment -%}

{%- liquid
  assign sf_qcount = section.blocks.size
  assign sf_default = section.settings.default_result_url | default: '#'
-%}
<div class="vy-sf color-{{ section.settings.color_scheme }} gradient vy-section">
  <div class="vy-container">
    <div class="vy-sf__layout {% if section.settings.image != blank %}vy-sf__layout--split{% endif %}">
      <div class="vy-sf__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vy-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vy-h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vy-sf__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.image != blank -%}
          <div class="vy-sf__media">
            {{
              section.settings.image
              | image_url: width: 700
              | image_tag: loading: 'lazy', widths: '320, 480, 700', sizes: '(min-width: 750px) 40vw, 90vw', class: 'vy-sf__img', alt: section.settings.heading | escape
            }}
          </div>
        {%- endif -%}
      </div>

      {%- if sf_qcount > 0 -%}
        <vy-shoe-finder
          class="vy-sf__card"
          data-default-url="{{ sf_default }}"
          data-cta-final="{{ section.settings.cta_final | default: 'See My Match' | escape }}"
        >
          <div class="vy-sf__progress" aria-hidden="true">
            <span class="vy-sf__progress-bar" data-sf-bar style="width: {{ 100 | divided_by: sf_qcount }}%;"></span>
          </div>
          <p class="vy-sf__counter caption">
            <span data-sf-current>1</span> / {{ sf_qcount }}
          </p>

          <form data-sf-form>
            {%- for block in section.blocks -%}
              <fieldset
                class="vy-sf__step{% if forloop.first %} is-active{% endif %}"
                data-sf-step="{{ forloop.index }}"
                {% unless forloop.first %}hidden{% endunless %}
                {{ block.shopify_attributes }}
              >
                <legend class="vy-sf__q">{{ block.settings.question }}</legend>
                <div class="vy-sf__options">
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign lkey = 'option_' | append: i | append: '_label'
                      assign ukey = 'option_' | append: i | append: '_url'
                      assign olabel = block.settings[lkey]
                      assign ourl = block.settings[ukey]
                    -%}
                    {%- if olabel != blank -%}
                      <label class="vy-sf__option">
                        <input
                          type="radio"
                          name="sf-q{{ forloop.parentloop.index }}"
                          value="{{ olabel | escape }}"
                          data-sf-url="{{ ourl }}"
                        >
                        <span class="vy-sf__option-label">{{ olabel }}</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}

            <div class="vy-sf__nav">
              <button type="button" class="button button--secondary vy-sf__back" data-sf-back hidden>
                {{ section.settings.cta_back | default: 'Back' }}
              </button>
              <button type="button" class="button vy-sf__next" data-sf-next disabled>
                {{ section.settings.cta_next | default: 'Next' }}
              </button>
            </div>
          </form>
        </vy-shoe-finder>
      {%- endif -%}
    </div>
  </div>
</div>

{%- else -%}{%- if request.design_mode -%}<div class="vy-hidden-note" style="padding:1.2rem 1.6rem;margin:0.4rem auto;max-width:60rem;border:0.1rem dashed rgba(128,128,128,0.55);border-radius:0.6rem;font-size:1.3rem;text-align:center;opacity:0.85;">Hidden on the current Store type (<b>{{ settings.store_type | default: 'v1' | upcase }}</b>). Shows on: <b>{{ section.settings.type_visibility | default: 'all' | upcase }}</b>. Change “Store type” in Theme settings, or this section’s “Show on store type”.</div>{%- endif -%}{%- endunless -%}

{% javascript %}
  class CustomShoeFinder extends HTMLElement {
    connectedCallback() {
      this.steps = Array.from(this.querySelectorAll('[data-sf-step]'));
      this.total = this.steps.length;
      this.current = 1;
      this.backBtn = this.querySelector('[data-sf-back]');
      this.nextBtn = this.querySelector('[data-sf-next]');
      this.bar = this.querySelector('[data-sf-bar]');
      this.counter = this.querySelector('[data-sf-current]');
      this.nextLabel = this.nextBtn ? this.nextBtn.textContent.trim() : 'Next';
      this.finalLabel = this.dataset.ctaFinal || 'See My Match';
      if (!this.steps.length || !this.nextBtn) return;

      this.addEventListener('change', (e) => {
        if (e.target && e.target.type === 'radio') this.nextBtn.disabled = false;
      });
      this.nextBtn.addEventListener('click', () => this.next());
      if (this.backBtn) this.backBtn.addEventListener('click', () => this.back());
      this.render();
    }

    currentStepEl() {
      return this.steps.find((s) => Number(s.dataset.sfStep) === this.current);
    }

    selectedInStep(step) {
      return step ? step.querySelector('input[type="radio"]:checked') : null;
    }

    next() {
      if (!this.selectedInStep(this.currentStepEl())) return;
      if (this.current < this.total) {
        this.current += 1;
        this.render();
      } else {
        this.finish();
      }
    }

    back() {
      if (this.current > 1) {
        this.current -= 1;
        this.render();
      }
    }

    finish() {
      let url = this.dataset.defaultUrl || '#';
      this.steps.forEach((step) => {
        const sel = this.selectedInStep(step);
        if (sel && sel.dataset.sfUrl) url = sel.dataset.sfUrl;
      });
      if (url && url !== '#') window.location.href = url;
    }

    render() {
      this.steps.forEach((step) => {
        const active = Number(step.dataset.sfStep) === this.current;
        step.hidden = !active;
        step.classList.toggle('is-active', active);
      });
      const step = this.currentStepEl();
      this.nextBtn.disabled = !this.selectedInStep(step);
      this.nextBtn.textContent = this.current === this.total ? this.finalLabel : this.nextLabel;
      if (this.backBtn) this.backBtn.hidden = this.current === 1;
      if (this.bar) this.bar.style.width = (this.current / this.total) * 100 + '%';
      if (this.counter) this.counter.textContent = String(this.current);
    }
  }
  if (!customElements.get('vy-shoe-finder')) {
    customElements.define('vy-shoe-finder', CustomShoeFinder);
  }
{% endjavascript %}

{% stylesheet %}
  .vy-sf__layout {
    display: grid;
    gap: 2.4rem;
    align-items: center;
  }

  .vy-sf__headings,
  .vy-sf__intro .vy-eyebrow {
    color: rgb(var(--color-accent-strong, var(--color-button)));
  }

  .vy-sf__intro .vy-h2 {
    margin: 0.4rem 0 0;
  }

  .vy-sf__sub {
    margin: 1rem 0 0;
    font-size: 1.5rem;
    opacity: 0.82;
    max-width: 46rem;
  }

  .vy-sf__media {
    margin-top: 2rem;
    border-radius: var(--vy-card-radius, 1.6rem);
    overflow: hidden;
  }

  .vy-sf__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .vy-sf__card {
    display: block;
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: var(--vy-card-radius, 1.6rem);
    padding: 2rem;
    box-shadow: 0 1.2rem 3.2rem rgba(var(--color-foreground), 0.08);
  }

  .vy-sf__progress {
    height: 0.5rem;
    border-radius: 999px;
    background: rgba(var(--color-foreground), 0.1);
    overflow: hidden;
  }

  .vy-sf__progress-bar {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: rgb(var(--color-button));
    transition: width 0.35s ease;
  }

  .vy-sf__counter {
    margin: 0.8rem 0 1.6rem;
    color: rgba(var(--color-foreground), 0.72);
  }

  .vy-sf__step {
    border: 0;
    margin: 0;
    padding: 0;
    min-inline-size: auto;
  }

  .vy-sf__q {
    padding: 0;
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1.4rem;
  }

  .vy-sf__options {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .vy-sf__option {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.3rem 1.5rem;
    border: 0.15rem solid rgba(var(--color-foreground), 0.14);
    border-radius: 1rem;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .vy-sf__option:has(input:checked) {
    border-color: rgb(var(--color-button));
    background: rgba(var(--color-button), 0.06);
  }

  .vy-sf__option input {
    accent-color: rgb(var(--color-button));
    width: 1.8rem;
    height: 1.8rem;
    flex: 0 0 auto;
  }

  .vy-sf__option-label {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .vy-sf__nav {
    display: flex;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .vy-sf__nav .button {
    flex: 1 1 auto;
  }

  .vy-sf__back {
    flex: 0 0 auto;
  }

  @media screen and (min-width: 750px) {
    .vy-sf__layout--split {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .vy-sf__card {
      padding: 2.8rem;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Shoe finder",
  "tag": "section",
  "class": "vy-sf-section",
  "settings": [
    {
      "type": "select",
      "id": "type_visibility",
      "label": "Show on store type",
      "info": "Which store types (V1/V2/V3) show this section. Affects home + product pages via the Store type setting.",
      "options": [
        { "value": "all", "label": "All layouts" },
        { "value": "v1", "label": "V1 only" },
        { "value": "v2", "label": "V2 only" },
        { "value": "v3", "label": "V3 only" },
        { "value": "v1v2", "label": "V1 + V2" },
        { "value": "v1v3", "label": "V1 + V3" },
        { "value": "v2v3", "label": "V2 + V3" }
      ],
      "default": "all"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not Sure Which Barevance Is Right for You?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Take our 30-second shoe finder and get a personalized recommendation." },
    { "type": "image_picker", "id": "image", "label": "Ảnh minh hoạ (tùy chọn)", "info": "Hiện cạnh quiz trên desktop." },
    { "type": "url", "id": "default_result_url", "label": "Kết quả mặc định (URL)", "info": "Dùng khi option được chọn không có URL riêng." },
    { "type": "text", "id": "cta_next", "label": "Nút tiếp", "default": "Next" },
    { "type": "text", "id": "cta_back", "label": "Nút quay lại", "default": "Back" },
    { "type": "text", "id": "cta_final", "label": "Nút kết thúc", "default": "See My Match" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Câu hỏi",
      "settings": [
        { "type": "text", "id": "question", "label": "Câu hỏi", "default": "What's your main activity?" },
        { "type": "header", "content": "Đáp án (mỗi đáp án có thể gắn 1 URL kết quả)" },
        { "type": "text", "id": "option_1_label", "label": "Đáp án 1", "default": "Everyday walking" },
        { "type": "url", "id": "option_1_url", "label": "Đáp án 1 → URL" },
        { "type": "text", "id": "option_2_label", "label": "Đáp án 2", "default": "Travel" },
        { "type": "url", "id": "option_2_url", "label": "Đáp án 2 → URL" },
        { "type": "text", "id": "option_3_label", "label": "Đáp án 3", "default": "Active & training" },
        { "type": "url", "id": "option_3_url", "label": "Đáp án 3 → URL" },
        { "type": "text", "id": "option_4_label", "label": "Đáp án 4" },
        { "type": "url", "id": "option_4_url", "label": "Đáp án 4 → URL" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shoe finder",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What's your main activity?",
            "option_1_label": "Everyday walking",
            "option_2_label": "Travel & long days",
            "option_3_label": "Active & training",
            "option_4_label": "Outdoor & trail"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do you like your fit?",
            "option_1_label": "Roomy & relaxed",
            "option_2_label": "Snug & secure",
            "option_3_label": "Somewhere in between"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Pick your style",
            "option_1_label": "Minimal & modern",
            "option_2_label": "Sporty",
            "option_3_label": "Casual everyday"
          }
        }
      ]
    }
  ]
}
{% endschema %}
