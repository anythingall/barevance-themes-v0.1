        "b4": {
          "type": "benefit",
          "settings": {
            "icon": "heart",
            "title": "Lightweight Design",
            "text": "Easy to carry all day."
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
