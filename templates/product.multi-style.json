{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "pdp_rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'custom-pdp-rating' %}"
          }
        },
        "pdp_trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'custom-pdp-trust' %}"
          }
        }
      },
      "block_order": [
        "pdp_rating",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "pdp_trust",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "mobile_thumbnails": "hide",
        "image_zoom": "lightbox",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "benefits": {
