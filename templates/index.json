            "title": "Cramped Toes",
            "text": "Traditional shoes can squeeze your toes."
          }
        },
        "c2": {
          "type": "card",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0645/7383/3450/files/photo-1732448393117-a91790b108d3.jpg?v=1790089726",
