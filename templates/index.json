            "text": "Your feet naturally flex as you walk."
          }
        },
        "c3": {
          "type": "card",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0645/7383/3450/files/photo-1581888748626-2a3f240a6f9f.jpg?v=1790089726",
            "title": "Heavy Feel",
            "text": "Why carry more shoe than you need?"
          }
        }
