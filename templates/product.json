{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "description": {
          "type": "description"
        },
        "pdp_rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'custom-pdp-rating' %}"
          }
        },
        "pdp_feats": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'custom-pdp-features' %}"
          }
        },
        "pdp_trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'custom-pdp-trust' %}"
          }
        }
      },
      "block_order": [
        "pdp_rating",
        "title",
        "price",
        "pdp_feats",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "pdp_trust",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "mobile_thumbnails": "hide",
        "image_zoom": "lightbox",
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "trust_bar": {
      "type": "custom-trust-badges",
      "settings": {
        "color_scheme": "scheme-1",
        "padding": "compact"
      },
      "blocks": {
        "b1": {
          "type": "badge",
          "settings": {
            "icon": "leaf",
            "title": "Wide Toe Box",
            "subtitle": "More space for your toes"
          }
        },
        "b2": {
          "type": "badge",
          "settings": {
            "icon": "check_mark",
            "title": "Flexible Sole",
            "subtitle": "Moves with every step"
          }
        },
        "b3": {
          "type": "badge",
          "settings": {
            "icon": "star",
            "title": "Zero Drop",
            "subtitle": "A natural, balanced posture"
          }
        },
        "b4": {
          "type": "badge",
          "settings": {
            "icon": "fire",
            "title": "Lightweight",
            "subtitle": "Less bulk, more freedom"
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ]
    },
    "problem": {
      "type": "custom-problem",
      "settings": {
        "color_scheme": "scheme-2",
        "eyebrow": "THE PROBLEM",
        "heading": "Your Feet Weren't Made to Be Squeezed.",
        "text": "<p>Traditional shoes can be narrow, stiff and heavy — leaving your feet tired and uncomfortable.</p>",
        "button_label": "Why Barefoot?",
        "button_link": "/pages/why-barefoot"
      },
      "blocks": {
        "l1": {
          "type": "list_item",
          "settings": {
            "icon_style": "cross",
            "text": "Narrow toe box cramps your toes"
          }
        },
        "l2": {
          "type": "list_item",
          "settings": {
            "icon_style": "cross",
            "text": "Stiff soles fight your natural stride"
          }
        },
        "l3": {
          "type": "list_item",
          "settings": {
            "icon_style": "cross",
            "text": "Heavy and restrictive all day"
          }
        }
      },
      "block_order": [
        "l1",
        "l2",
        "l3"
      ]
    },
    "benefits": {
      "type": "custom-icon-benefits",
      "settings": {
        "color_scheme": "scheme-1",
        "source": "blocks",
        "heading": "Why Mirox Feels Different",
        "heading_alignment": "center",
        "columns": 4,
        "mobile_layout": "carousel"
      },
      "blocks": {
        "b1": {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "title": "Roomy Toe Box",
            "text": "Give your toes space to spread and move naturally."
          }
        },
        "b2": {
          "type": "benefit",
          "settings": {
            "icon": "check_mark",
            "title": "Flexible Sole",
            "text": "Designed to flex with your feet as you walk."
          }
        },
        "b3": {
          "type": "benefit",
          "settings": {
            "icon": "fire",
            "title": "Lightweight Construction",
            "text": "Less bulk between you and the ground."
          }
        },
        "b4": {
          "type": "benefit",
          "settings": {
            "icon": "heart",
            "title": "Everyday Comfort",
            "text": "Made for walking, errands, travel and daily wear."
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ]
    },
