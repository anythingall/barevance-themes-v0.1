    "faq": {
      "type": "custom-faq",
      "settings": {
        "color_scheme": "scheme-1",
        "source": "blocks",
        "heading": "Frequently Asked Questions",
        "heading_alignment": "left",
        "columns": "2"
      },
      "blocks": {
        "q1": {
          "type": "item",
          "settings": {
            "question": "Is Mirox a barefoot shoe?",
            "answer": "<p>Yes — Mirox uses a wide toe box, flexible sole and zero-drop platform for a natural-feeling stride.</p>"
          }
        },
        "q2": {
          "type": "item",
          "settings": {
            "question": "How much room should I have around my toes?",
            "answer": "<p>Your toes should be able to spread with a little room at the front — not cramped, not sliding around.</p>"
          }
        },
        "q3": {
          "type": "item",
          "settings": {
            "question": "Does Mirox run true to size?",
            "answer": "<p>Most customers find Mirox true to size. If you are between sizes or have wide feet, size up.</p>"
          }
        },
        "q4": {
          "type": "item",
          "settings": {
            "question": "Can I wear Mirox without socks?",
            "answer": "<p>Yes. The breathable interior is comfortable with thin socks or barefoot.</p>"
          }
        },
        "q5": {
          "type": "item",
          "settings": {
            "question": "Is Mirox good for walking?",
            "answer": "<p>Mirox is built for everyday walking, errands, travel and light activity.</p>"
          }
        },
        "q6": {
          "type": "item",
          "settings": {
            "question": "Can I return it if the size isn't right?",
            "answer": "<p>Yes — we offer 30-day returns so you can find the right fit with confidence.</p>"
          }
        }
      },
