      "blocks": {
        "q1": {
          "type": "item",
          "settings": {
            "question": "How should barefoot shoes fit?",
            "answer": "<p>Your toes should have room to spread, with a snug (not tight) midfoot and heel.</p>"
          }
        },
        "q2": {
          "type": "item",
          "settings": {
            "question": "What size should I choose?",
            "answer": "<p>Most customers stay true to size. If between sizes or wide-footed, size up.</p>"
          }
        },
        "q3": {
          "type": "item",
          "settings": {
            "question": "Can I return them if they don't fit?",
            "answer": "<p>Yes \u2014 30-day returns so you can find the right fit with confidence.</p>"
          }
        },
        "q4": {
          "type": "item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders ship within 1\u20132 business days with tracking.</p>"
          }
        },
        "q5": {
          "type": "item",
          "settings": {
            "question": "Are Voya shoes suitable for everyday walking?",
            "answer": "<p>Yes \u2014 Voya is designed for everyday walking, travel and light activity.</p>"
          }
        },
        "q6": {
          "type": "item",
          "settings": {
            "question": "How do barefoot shoes differ from regular shoes?",
            "answer": "<p>Wider toe box, flexible sole and a zero-drop platform for natural movement.</p>"
          }
        }
      },
