        },
        "b3": {
          "type": "badge",
          "settings": {
            "icon": "padlock",
            "title": "Secure Checkout",
            "subtitle": "100% safe & encrypted"
          }
        },
        "b4": {
          "type": "badge",
          "settings": {
            "icon": "chat_bubble",
            "title": "24/7 Support",
            "subtitle": "We're here anytime"
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4"
      ]
