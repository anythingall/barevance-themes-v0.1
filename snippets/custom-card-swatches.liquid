{% comment %}
  vy-card-swatches — Color swatch row for a product card (mobile-first).
  Shows up to `limit` colour dots from the product's "Color"/"Colour" option (or the
  first swatch-configured option), with a "+N" overflow chip. Decorative — the card
  already links to the product — so it's aria-hidden with a visually-hidden count.
  Colour comes from the native option-value swatch when configured, else a built-in
  name→hex map (Black, White, Sage, Sand, Navy, Grey, Olive, Brown, Cream, Blue…),
  so it works without any Shopify swatch/metaobject setup.

  Accepts:
  - card_product: {Object} product
  - limit: {Number} max swatches before "+N" (optional, default 4)
{% endcomment %}
{%- liquid
  assign color_option = null
  for option in card_product.options_with_values
    assign oname = option.name | downcase
    if oname contains 'color' or oname contains 'colour'
      assign color_option = option
      break
    endif
  endfor
  if color_option == null
    for option in card_product.options_with_values
      assign sc = option.values | map: 'swatch' | compact | size
      if sc > 0
        assign color_option = option
        break
      endif
    endfor
  endif
-%}
{%- if color_option -%}
  {%- liquid
    assign lim = limit | default: 4
    assign total = color_option.values | size
    assign overflow = total | minus: lim
  -%}
  <div class="vy-card-swatches">
    <span class="visually-hidden">{{ total }} {{ color_option.name | downcase }} options</span>
    <span class="vy-card-swatches__row" aria-hidden="true">
      {%- for value in color_option.values limit: lim -%}
        {%- liquid
          assign hex = ''
          if value.swatch.color
            assign hex = value.swatch.color
          else
            assign vn = value.name | downcase | strip
            case vn
              when 'black'
                assign hex = '#1c1c1e'
              when 'white'
                assign hex = '#f1f1ef'
              when 'sage'
                assign hex = '#9fb4a0'
              when 'cream'
                assign hex = '#e9e0cd'
              when 'sand', 'beige', 'tan'
                assign hex = '#d8c6a8'
              when 'navy'
                assign hex = '#2b3a55'
              when 'blue'
                assign hex = '#7f9fc4'
              when 'grey', 'gray'
                assign hex = '#a9adb0'
              when 'olive'
                assign hex = '#5b6236'
              when 'green'
                assign hex = '#4a6b4a'
              when 'brown'
                assign hex = '#7a5b40'
              when 'red'
                assign hex = '#b0413e'
              when 'pink', 'rose'
                assign hex = '#d9a3ad'
              when 'stone'
                assign hex = '#cbc2b4'
              else
                assign hex = '#c9c9c5'
            endcase
          endif
        -%}
        <span class="vy-card-swatches__dot" style="background:{{ hex }};" title="{{ value.name | escape }}"></span>
      {%- endfor -%}
      {%- if overflow > 0 -%}
        <span class="vy-card-swatches__more">+{{ overflow }}</span>
      {%- endif -%}
    </span>
  </div>
{%- endif -%}
