{% comment %}
  Renders a colour option's values as variant-image thumbnail swatches.
  Outputs radio inputs inside the caller's <fieldset> so Dawn's <variant-selects>
  reads them exactly like the native button/swatch pickers.

  Accepts:
  - product: {Object}
  - option: {Object} the colour product_option
  - section_id: {String}
  - product_form_id: {String}
{% endcomment %}
{%- liquid
  assign opt_index = option.position | minus: 1
-%}
<div class="vy-color-swatches">
  {%- for value in option.values -%}
    {%- liquid
      capture vname
        echo value
      endcapture
      assign vname = vname | strip

      assign v_image = null
      for variant in product.variants
        if variant.options[opt_index] == vname and variant.image != blank
          assign v_image = variant.image
          break
        endif
      endfor
      if v_image == null
        assign v_image = product.featured_image
      endif

      assign input_id = section_id | append: '-color-' | append: forloop.index0
      assign option_disabled = true
      if value.available
        assign option_disabled = false
      endif
    -%}
    <input
      type="radio"
      class="vy-color-swatch__input{% if option_disabled %} disabled{% endif %}"
      id="{{ input_id }}"
      name="{{ option.name }}-{{ option.position }}"
      value="{{ value | escape }}"
      form="{{ product_form_id }}"
      {% if value.selected %}checked{% endif %}
      data-product-url="{{ value.product_url }}"
      data-option-value-id="{{ value.id }}"
      data-option-name="{{ option.name | escape }}"
    >
    <label class="vy-color-swatch" for="{{ input_id }}" title="{{ value | escape }}">
      {%- if v_image != blank -%}
        <img
          src="{{ v_image | image_url: width: 220 }}"
          srcset="{{ v_image | image_url: width: 110 }} 1x, {{ v_image | image_url: width: 220 }} 2x"
          alt="{{ value | escape }}"
          width="110"
          height="110"
          loading="lazy"
        >
      {%- else -%}
        <span class="vy-color-swatch__name">{{ value }}</span>
      {%- endif -%}
      <span class="visually-hidden">{{ value }}</span>
    </label>
  {%- endfor -%}
</div>
