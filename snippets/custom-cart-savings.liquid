{% doc %}
  Renders total cart savings across ALL applied discounts (automatic discounts,
  codes, quantity/volume breaks) using the real cart.total_discount. Shows a
  "X% OFF" badge + the saved amount. Nothing renders when there is no discount.
  @param {string} [layout] - 'row' (cart drawer/totals) or 'inline' (cart page)
  @example
  {% render 'custom-cart-savings', layout: 'row' %}
{% enddoc %}

{%- if cart.total_discount > 0 -%}
  {%- liquid
    assign layout = layout | default: 'row'
    assign saved = cart.total_discount | money
    assign original = cart.total_price | plus: cart.total_discount
    assign pct = 0
    if original > 0
      assign pct = cart.total_discount | times: 100.0 | divided_by: original | round
    endif
  -%}
  <div class="vy-cart-savings vy-cart-savings--{{ layout }}" role="status">
    <span class="vy-cart-savings__label">{{ 'customer.order.discount' | t | default: 'You save' }}</span>
    {%- if pct > 0 -%}
      <span class="vy-cart-savings__badge">{{ pct }}% OFF</span>
    {%- endif -%}
    <span class="vy-cart-savings__amount">-{{ saved }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .vy-cart-savings {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    margin: 0.8rem 0;
    color: rgb(var(--color-foreground));
  }

  .vy-cart-savings--row {
    justify-content: space-between;
  }

  .vy-cart-savings__label {
    font-weight: 600;
  }

  .vy-cart-savings__badge {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.03em;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-right: auto;
  }

  .vy-cart-savings--inline .vy-cart-savings__badge {
    margin-right: 0;
  }

  .vy-cart-savings__amount {
    font-weight: 700;
    color: rgb(var(--color-button));
  }
{% endstylesheet %}
