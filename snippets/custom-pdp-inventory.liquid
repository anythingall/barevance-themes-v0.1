{% doc %}
  Inventory status pill for the PDP: a colored status dot + label
  (In stock / Low stock / Out of stock), based on the selected variant.
  Uses the theme's own inventory locale strings so it stays translatable.
  @example {% render 'custom-pdp-inventory' %}
{% enddoc %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign low_threshold = 10

  assign state = 'in'
  assign label = 'products.product.inventory_in_stock' | t

  unless variant.available
    assign state = 'out'
    assign label = 'products.product.inventory_out_of_stock' | t
  endunless

  if variant.available and variant.inventory_management != blank and variant.inventory_policy == 'deny'
    if variant.inventory_quantity <= 0
      assign state = 'out'
      assign label = 'products.product.inventory_out_of_stock' | t
    elsif variant.inventory_quantity <= low_threshold
      assign state = 'low'
      assign label = 'products.product.inventory_low_stock' | t
    endif
  endif
-%}
<div class="vy-pdp-stock vy-pdp-stock--{{ state }}">
  <span class="vy-pdp-stock__dot" aria-hidden="true"></span>
  <span class="vy-pdp-stock__label">{{ label }}</span>
</div>
{% stylesheet %}
  .vy-pdp-stock {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 1.2rem 0 0;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1;
    color: rgb(var(--color-foreground));
  }
  .vy-pdp-stock__dot {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    flex: 0 0 auto;
    background: var(--vy-stock-color, #2fbf71);
    box-shadow: 0 0 0 0.4rem var(--vy-stock-halo, rgba(47, 191, 113, 0.18));
  }
  .vy-pdp-stock--in {
    --vy-stock-color: #2fbf71;
    --vy-stock-halo: rgba(47, 191, 113, 0.18);
  }
  .vy-pdp-stock--low {
    --vy-stock-color: #e0a13a;
    --vy-stock-halo: rgba(224, 161, 58, 0.18);
  }
  .vy-pdp-stock--out {
    --vy-stock-color: #c0473f;
    --vy-stock-halo: rgba(192, 71, 63, 0.18);
  }
{% endstylesheet %}
