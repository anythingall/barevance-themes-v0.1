{% doc %}
  Small star rating + review count line for the product buy area.
  Reads product.metafields.custom.rating_text if set, else a default.
  @example {% render 'custom-pdp-rating' %}
{% enddoc %}
<div class="vy-pdp-rating">
  {%- render 'custom-stars', rating: 5 -%}
  <span class="vy-pdp-rating__text">
    {{- product.metafields.custom.rating_text | default: '4.9 (878 reviews)' -}}
  </span>
</div>
{% stylesheet %}
  .vy-pdp-rating {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  .vy-pdp-rating__text {
    font-size: 1.4rem;
    opacity: 0.85;
  }
{% endstylesheet %}
