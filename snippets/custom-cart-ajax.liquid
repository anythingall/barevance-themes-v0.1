{%- comment -%}
  custom-cart-ajax — progressive enhancement for add-to-cart forms.

  Any <form data-ajax-cart> is submitted with fetch to /cart/add.js and the Dawn cart
  drawer is refreshed + opened, instead of a full-page reload to /cart. Falls back to a
  normal submit when there is no cart drawer or on any error, so it never blocks a sale.
  Render once per page (guarded); used by custom-pricing-tiers and custom-frequently-bought.
{%- endcomment -%}
<script>
  (function () {
    if (window.__customCartAjax) return;
    window.__customCartAjax = true;
    document.addEventListener('submit', function (e) {
      var form = e.target.closest && e.target.closest('form[data-ajax-cart]');
      if (!form) return;
      var drawer = document.querySelector('cart-drawer');
      if (!drawer || typeof drawer.renderContents !== 'function') return; // no drawer -> normal submit
      e.preventDefault();
      var btn = form.querySelector('[type="submit"]');
      if (btn) { btn.setAttribute('disabled', ''); btn.setAttribute('aria-busy', 'true'); btn.classList.add('loading'); }
      var root = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      var fd = new FormData(form);
      try {
        var ids = typeof drawer.getSectionsToRender === 'function'
          ? drawer.getSectionsToRender().map(function (s) { return s.id; })
          : ['cart-drawer', 'cart-icon-bubble'];
        fd.append('sections', ids.join(','));
        fd.append('sections_url', window.location.pathname);
      } catch (err) {}
      fetch(root + 'cart/add.js', { method: 'POST', headers: { Accept: 'application/javascript' }, body: fd })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (data && data.status) { form.submit(); return; } // e.g. sold out -> let Shopify show the error
          drawer.renderContents(data);
        })
        .catch(function () { form.submit(); })
        .finally(function () {
          if (btn) { btn.removeAttribute('disabled'); btn.removeAttribute('aria-busy'); btn.classList.remove('loading'); }
        });
    });
  })();
</script>
